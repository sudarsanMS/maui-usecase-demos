<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SmartMovieBooking.Models"
             xmlns:conv="clr-namespace:SmartMovieBooking.Converters"
             x:Class="SmartMovieBooking.Controls.MovieCardView">

    <Border Style="{StaticResource TileCard}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCardTapped" />
        </Border.GestureRecognizers>
        <VerticalStackLayout Spacing="0">
            <!-- Poster area (placeholder gradient until images are added) -->
            <Grid HeightRequest="220" BackgroundColor="{DynamicResource ThemeSurfaceContainer}">
                <Label Text="🎬" FontSize="64"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{DynamicResource ThemeOutline}" />

                <!-- Rating badge (top-right) -->
                <Border BackgroundColor="{DynamicResource ThemeInverseSurface}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 999"
                        Padding="10,4"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,12,12,0">
                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="★" FontSize="11"
                               TextColor="{DynamicResource ThemeTertiaryContainer}" />
                        <Label Text="{Binding Rating}" FontFamily="PlusJakartaBold" FontSize="11"
                               TextColor="{DynamicResource ThemeInverseOnSurface}" />
                    </HorizontalStackLayout>
                </Border>

                <!-- IMAX/3D format chip (top-left) -->
                <Border BackgroundColor="{DynamicResource ThemePrimaryContainer}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 999"
                        Padding="10,4"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Margin="12,12,0,0"
                        IsVisible="{Binding Format, Converter={StaticResource NotNullConverter}}">
                    <Label Text="{Binding Format}" FontFamily="PlusJakartaBold" FontSize="10"
                           TextColor="{DynamicResource ThemeOnPrimaryContainer}" />
                </Border>
            </Grid>

            <!-- Body -->
            <VerticalStackLayout Padding="16" Spacing="6">
                <Label Text="{Binding Title}" Style="{StaticResource HeadlineSmLabel}"
                       TextColor="{DynamicResource ThemeOnSurface}"
                       LineBreakMode="TailTruncation" MaxLines="1" />
                <Label Text="{Binding Tagline}" Style="{StaticResource BodySmLabel}"
                       TextColor="{DynamicResource ThemeOnSurfaceVariant}"
                       LineBreakMode="TailTruncation" MaxLines="1" />

                <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                    <Border BackgroundColor="{DynamicResource ThemeSecondaryContainer}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 999"
                            Padding="8,2">
                        <Label Text="{Binding PrimaryGenre}" FontFamily="InterSemiBold" FontSize="10"
                               TextColor="{DynamicResource ThemeOnSecondaryContainer}" />
                    </Border>
                    <Label Text="{Binding Duration}" Style="{StaticResource LabelSmLabel}"
                           TextColor="{DynamicResource ThemeOnSurfaceVariant}"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="6" Margin="0,8,0,0"
                                       VerticalOptions="Center">
                    <Label Text="⏱" FontSize="11" TextColor="{DynamicResource ThemeOutline}" />
                    <Label Text="{Binding Duration}" Style="{StaticResource LabelMdLabel}"
                           TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                    <Label Text="·" FontSize="11" TextColor="{DynamicResource ThemeOutline}" />
                    <Label Text="{Binding Certificate}" Style="{StaticResource LabelMdLabel}"
                           TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                    <Label Text="·" FontSize="11" TextColor="{DynamicResource ThemeOutline}" />
                    <Label Text="{Binding Languages[0]}" Style="{StaticResource LabelMdLabel}"
                           TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>