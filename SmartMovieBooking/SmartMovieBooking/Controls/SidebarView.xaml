<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartMovieBooking.ViewModels"
             xmlns:conv="clr-namespace:SmartMovieBooking.Converters"
             x:Class="SmartMovieBooking.Controls.SidebarView">
    <ContentView.Resources>
        <conv:SelectedToBackgroundConverter x:Key="SelectedBg" />
        <conv:SelectedToForegroundConverter x:Key="SelectedFg" />
    </ContentView.Resources>

    <Grid WidthRequest="256"
          BackgroundColor="{DynamicResource ThemeSurface}"
          RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Brand block -->
        <VerticalStackLayout Grid.Row="0" Spacing="12" Padding="20,20,20,16">
            <HorizontalStackLayout Spacing="10">
                <Border WidthRequest="36" HeightRequest="36"
                        BackgroundColor="{DynamicResource ThemePrimary}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8">
                    <Label Text="🎬" FontSize="18"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>
                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                    <Label Text="Smart Cinema" FontFamily="PlusJakartaBold" FontSize="14"
                           TextColor="{DynamicResource ThemeOnSurface}" />
                    <Label Text="MAUI Pro Engine" FontFamily="InterRegular" FontSize="10"
                           TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Explore Hub section header -->
        <Label Grid.Row="1"
               Text="EXPLORE HUB"
               FontFamily="PlusJakartaSemiBold"
               FontSize="10"
               TextColor="{DynamicResource ThemeOutline}"
               Margin="20,12,20,4" />

        <!-- Nav items -->
        <VerticalStackLayout Grid.Row="2" Spacing="4" Margin="12,0">
            <Border Padding="12,10" StrokeThickness="0"
                    BackgroundColor="{Binding IsMovieHomeSelected, Source={x:Reference Self}, Converter={StaticResource SelectedBg}}"
                    StrokeShape="RoundRectangle 12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMovieHomeTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="12">
                    <Label Text="🎞" FontSize="18" VerticalTextAlignment="Center" />
                    <Label Text="Movie Home"
                           FontFamily="PlusJakartaSemiBold"
                           FontSize="13"
                           VerticalTextAlignment="Center"
                           TextColor="{Binding IsMovieHomeSelected, Source={x:Reference Self}, Converter={StaticResource SelectedFg}}" />
                </HorizontalStackLayout>
            </Border>

            <Border Padding="12,10" StrokeThickness="0"
                    BackgroundColor="{Binding IsTheatersSelected, Source={x:Reference Self}, Converter={StaticResource SelectedBg}}"
                    StrokeShape="RoundRectangle 12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTheatersTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="12">
                    <Label Text="🏛" FontSize="18" VerticalTextAlignment="Center" />
                    <Label Text="Theaters"
                           FontFamily="PlusJakartaSemiBold"
                           FontSize="13"
                           VerticalTextAlignment="Center"
                           TextColor="{Binding IsTheatersSelected, Source={x:Reference Self}, Converter={StaticResource SelectedFg}}" />
                </HorizontalStackLayout>
            </Border>

            <Border Padding="12,10" StrokeThickness="0"
                    BackgroundColor="{Binding IsBookingsSelected, Source={x:Reference Self}, Converter={StaticResource SelectedBg}}"
                    StrokeShape="RoundRectangle 12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBookingsTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="12">
                    <Label Text="🎫" FontSize="18" VerticalTextAlignment="Center" />
                    <Label Text="Bookings"
                           FontFamily="PlusJakartaSemiBold"
                           FontSize="13"
                           VerticalTextAlignment="Center"
                           TextColor="{Binding IsBookingsSelected, Source={x:Reference Self}, Converter={StaticResource SelectedFg}}" />
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- Footer: Region Service status -->
        <Border Grid.Row="4"
                BackgroundColor="{DynamicResource ThemeSurfaceContainerLow}"
                StrokeThickness="0"
                Margin="12,0,12,16"
                Padding="14"
                StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="6">
                <HorizontalStackLayout Spacing="8">
                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4"
                             Color="{DynamicResource ThemeSuccess}"
                             VerticalOptions="Center" />
                    <Label Text="Region Service"
                           FontFamily="PlusJakartaSemiBold"
                           FontSize="12"
                           TextColor="{DynamicResource ThemeOnSurface}" />
                </HorizontalStackLayout>
                <Label Text="Live Synced"
                       FontFamily="InterRegular"
                       FontSize="11"
                       TextColor="{DynamicResource ThemeOnSurfaceVariant}"
                       Margin="16,0,0,0" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>