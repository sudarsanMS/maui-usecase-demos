<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SmartMovieBooking.Models"
             x:Class="SmartMovieBooking.Controls.SeatTileView">

    <Border WidthRequest="28" HeightRequest="28"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 6"
            Padding="0">
        <Border.Triggers>
            <!-- Available -->
            <DataTrigger TargetType="Border" Binding="{Binding State}" Value="Available">
                <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSurfaceContainerLow}" />
            </DataTrigger>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BackgroundColor" Value="{DynamicResource ThemePrimary}" />
            </DataTrigger>
            <DataTrigger TargetType="Border" Binding="{Binding State}" Value="Occupied">
                <Setter Property="BackgroundColor" Value="{DynamicResource ThemeOutlineVariant}" />
                <Setter Property="Opacity" Value="0.5" />
            </DataTrigger>
            <DataTrigger TargetType="Border" Binding="{Binding State}" Value="Aisle">
                <Setter Property="BackgroundColor" Value="Transparent" />
            </DataTrigger>
        </Border.Triggers>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
        <Label Text="{Binding Id}"
               FontSize="8"
               FontFamily="InterSemiBold"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               TextColor="{DynamicResource ThemeOnSurfaceVariant}">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="TextColor" Value="{DynamicResource ThemeOnPrimary}" />
                </DataTrigger>
            </Label.Triggers>
        </Label>
    </Border>
</ContentView>