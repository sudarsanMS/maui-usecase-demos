<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SmartMovieBooking.Models"
             x:Class="SmartMovieBooking.Controls.HeroCardView">

    <Border StrokeThickness="0"
            StrokeShape="RoundRectangle 16"
            HeightRequest="320"
            Padding="0">
        <Grid>
            <!-- Poster area (gradient placeholder) -->
            <BoxView Color="{DynamicResource ThemePrimaryContainer}" />

            <!-- Star backdrop effect -->
            <BoxView Color="#20000000" />

            <!-- Content overlay -->
            <Grid Padding="20,16" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">

                <!-- Top chips row -->
                <HorizontalStackLayout Grid.Row="0" Spacing="8">
                    <Border BackgroundColor="{DynamicResource ThemePrimary}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 999"
                            Padding="10,4">
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="✨" FontSize="10" TextColor="{DynamicResource ThemeOnPrimary}" />
                            <Label Text="FEATURED" FontFamily="PlusJakartaBold" FontSize="10"
                                   TextColor="{DynamicResource ThemeOnPrimary}" />
                        </HorizontalStackLayout>
                    </Border>
                    <Border BackgroundColor="{DynamicResource ThemeInverseSurface}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 999"
                            Padding="10,4">
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="IMAX 3D" FontFamily="PlusJakartaBold" FontSize="10"
                                   TextColor="{DynamicResource ThemeInverseOnSurface}" />
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>

                <!-- Empty middle -->
                <BoxView Grid.Row="1" Color="Transparent" />

                <!-- Title -->
                <Label Grid.Row="2"
                       Text="{Binding Title, FallbackValue='Featured Movie'}"
                       FontFamily="PlusJakartaExtraBold" FontSize="28"
                       LineHeight="32"
                       TextColor="White"
                       MaxLines="2" />

                <!-- Meta row -->
                <HorizontalStackLayout Grid.Row="3" Spacing="12" VerticalOptions="Center">
                    <Label Text="★"
                           FontSize="14"
                           TextColor="#FFC107" />
                    <Label Text="{Binding Rating, FallbackValue='4.9'}"
                           FontFamily="PlusJakartaBold" FontSize="14"
                           TextColor="White" />
                    <Label Text="{Binding Duration, FallbackValue='2h 45m'}"
                           FontFamily="InterRegular" FontSize="14"
                           TextColor="White" Opacity="0.9" />
                </HorizontalStackLayout>
            </Grid>
        </Grid>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
    </Border>
</ContentView>