<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartMovieBooking.Controls.ConciergePromoView">

    <Border StrokeThickness="0"
            StrokeShape="RoundRectangle 16"
            BackgroundColor="{DynamicResource ThemeTertiaryContainer}"
            Padding="16">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
            <Border Grid.Column="0"
                    WidthRequest="44" HeightRequest="44"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{DynamicResource ThemeTertiary}">
                <Label Text="🎩" FontSize="22"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Seat Concierge AI"
                       FontFamily="PlusJakartaBold" FontSize="14"
                       TextColor="{DynamicResource ThemeOnTertiaryContainer}" />
                <Label Text="Find sweet-spot seats in Dolby &amp; IMAX theaters"
                       Style="{StaticResource BodySmLabel}"
                       TextColor="{DynamicResource ThemeOnTertiaryContainer}"
                       Opacity="0.85" />
            </VerticalStackLayout>
            <Border Grid.Column="2"
                    BackgroundColor="{DynamicResource ThemeSurface}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 999"
                    Padding="14,6">
                <Label Text="Try Now →" FontFamily="PlusJakartaBold" FontSize="12"
                       TextColor="{DynamicResource ThemeTertiary}" />
            </Border>
        </Grid>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
    </Border>
</ContentView>