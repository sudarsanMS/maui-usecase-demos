<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SmartMovieBooking.Models"
             x:Class="SmartMovieBooking.Controls.DateChipView">

    <Border StrokeThickness="0"
            Padding="14,8"
            StrokeShape="RoundRectangle 16"
            WidthRequest="86">
        <Border.Triggers>
            <DataTrigger TargetType="Border"
                         Binding="{Binding IsSelected}"
                         Value="True">
                <Setter Property="BackgroundColor" Value="{DynamicResource ThemePrimaryContainer}" />
            </DataTrigger>
            <DataTrigger TargetType="Border"
                         Binding="{Binding IsSelected}"
                         Value="False">
                <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSurfaceContainerLowest}" />
            </DataTrigger>
        </Border.Triggers>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
            <Label Text="{Binding Label}"
                   FontFamily="PlusJakartaSemiBold"
                   FontSize="10"
                   HorizontalTextAlignment="Center"
                   TextColor="{DynamicResource ThemeOutline}" />
            <Label Text="{Binding DayNumber}"
                   FontFamily="PlusJakartaExtraBold"
                   FontSize="22"
                   HorizontalTextAlignment="Center"
                   TextColor="{DynamicResource ThemeOnSurface}" />
            <Label Text="{Binding Weekday}"
                   FontFamily="InterSemiBold"
                   FontSize="10"
                   HorizontalTextAlignment="Center"
                   TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
        </VerticalStackLayout>
    </Border>
</ContentView>