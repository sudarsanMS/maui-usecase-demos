<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartMovieBooking.ViewModels"
             x:Class="SmartMovieBooking.Controls.HeaderBarView">

    <Grid HeightRequest="64"
          BackgroundColor="{DynamicResource ThemeSurface}"
          ColumnDefinitions="Auto,*,Auto,Auto"
          ColumnSpacing="16"
          Padding="24,0">

        <!-- City + location -->
        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
            <Label Text="📍" FontSize="18" VerticalTextAlignment="Center" />
            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                <Label Text="DELIVER TO"
                       FontFamily="PlusJakartaSemiBold"
                       FontSize="10"
                       TextColor="{DynamicResource ThemeOutline}" />
                <Label Text="{Binding CityLabel}"
                       FontFamily="PlusJakartaBold"
                       FontSize="13"
                       TextColor="{DynamicResource ThemeOnSurface}" />
            </VerticalStackLayout>
            <Label Text="▾" FontSize="12" VerticalTextAlignment="Center"
                   TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
        </HorizontalStackLayout>

        <!-- Search -->
        <Border Grid.Column="1"
                BackgroundColor="{DynamicResource ThemeSurfaceContainerLow}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12"
                Padding="14,0"
                HeightRequest="40">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Grid.Column="0" Text="🔍" FontSize="14"
                       VerticalTextAlignment="Center" />
                <Entry Grid.Column="1"
                       Placeholder="Search movies, theaters, showtimes…"
                       PlaceholderColor="{DynamicResource ThemeOnSurfaceVariant}"
                       TextColor="{DynamicResource ThemeOnSurface}"
                       FontFamily="InterRegular"
                       FontSize="13"
                       BackgroundColor="Transparent"
                       VerticalTextAlignment="Center" />
            </Grid>
        </Border>

        <!-- Bell button -->
        <Button Grid.Column="2"
                Text="🔔"
                Style="{StaticResource IconButton}" />

        <!-- User avatar -->
        <Border Grid.Column="3"
                WidthRequest="40" HeightRequest="40"
                StrokeThickness="0"
                BackgroundColor="{DynamicResource ThemePrimaryContainer}"
                StrokeShape="RoundRectangle 12">
            <Label Text="{Binding UserAvatarInitials}"
                   FontFamily="PlusJakartaBold"
                   FontSize="14"
                   TextColor="{DynamicResource ThemeOnPrimary}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />
        </Border>
    </Grid>
</ContentView>