<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SmartMovieBooking.Models"
             xmlns:controls="clr-namespace:SmartMovieBooking.Controls"
             x:Class="SmartMovieBooking.Controls.TheaterCardView">

    <Border Style="{StaticResource SurfaceCard}" Padding="24">
        <VerticalStackLayout Spacing="16">

            <!-- Header: icon + name + price + heart -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Border Grid.Column="0"
                        Style="{StaticResource IconTile}"
                        WidthRequest="56" HeightRequest="56">
                    <Label Text="{Binding Icon, FallbackValue='🎬'}"
                           FontSize="28"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           TextColor="{DynamicResource ThemePrimary}" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="{Binding Name}" Style="{StaticResource HeadlineSmLabel}"
                               TextColor="{DynamicResource ThemeOnSurface}" />
                        <Border BackgroundColor="{DynamicResource ThemeSurfaceContainerHigh}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 999"
                                Padding="8,2"
                                IsVisible="{Binding Badge, Converter={StaticResource NotNullConverter}}">
                            <Label Text="{Binding Badge}" FontFamily="InterSemiBold" FontSize="10"
                                   TextColor="{DynamicResource ThemeTertiary}" />
                        </Border>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="📍" FontSize="11" TextColor="{DynamicResource ThemeTertiary}" />
                        <Label Text="{Binding Location}" Style="{StaticResource BodySmLabel}"
                               TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                        <Label Text="·" Style="{StaticResource BodySmLabel}" TextColor="{DynamicResource ThemeOutline}" />
                        <Label Text="{Binding DistanceLabel}" Style="{StaticResource BodySmLabel}"
                               TextColor="{DynamicResource ThemePrimary}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center">
                    <Label Text="From" Style="{StaticResource LabelSmLabel}"
                           HorizontalTextAlignment="End"
                           TextColor="{DynamicResource ThemeOutline}" />
                    <Label Text="{Binding PriceFrom}" Style="{StaticResource HeadlineSmLabel}"
                           HorizontalTextAlignment="End"
                           TextColor="{DynamicResource ThemeOnSurface}" />
                    <Label Text="{Binding AvailableSeats, StringFormat='{0} seats available'}"
                           Style="{StaticResource BodySmLabel}"
                           HorizontalTextAlignment="End"
                           TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                </VerticalStackLayout>

                <Button Grid.Column="3" Text="♥"
                        Style="{StaticResource IconButton}"
                        VerticalOptions="Center" />
            </Grid>

            <!-- Facility badges -->
            <HorizontalStackLayout Spacing="6"
                                   BindableLayout.ItemsSource="{Binding Facilities}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:TheaterFacility">
                        <Border BackgroundColor="{DynamicResource ThemeSurfaceContainer}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="8,4">
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Icon}" FontSize="12"
                                       TextColor="{DynamicResource ThemePrimary}" />
                                <Label Text="{Binding Label}" FontFamily="InterSemiBold" FontSize="11"
                                       TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>

            <!-- Showtime pills grid -->
            <Label Text="SELECT SCREENING TIME" Style="{StaticResource LabelSmLabel}"
                   TextColor="{DynamicResource ThemeOutline}" />
            <FlexLayout BindableLayout.ItemsSource="{Binding Showtimes}"
                        Wrap="Wrap"
                        Direction="Row"
                        JustifyContent="Start"
                        AlignItems="Start">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Showtime">
                        <controls:ShowtimePillView Margin="0,0,8,8"
                                                   Showtime="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- Action bar -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                    <Label Text="✓" FontSize="14" TextColor="{DynamicResource ThemePrimary}" />
                    <Label Text="Dolby Vision 4K projection certified" Style="{StaticResource BodySmLabel}"
                           TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                </HorizontalStackLayout>
                <Button Grid.Column="1" Text="Select Showtime &amp; Continue →"
                        Clicked="OnContinueClicked"
                        Style="{StaticResource PrimaryButton}" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>