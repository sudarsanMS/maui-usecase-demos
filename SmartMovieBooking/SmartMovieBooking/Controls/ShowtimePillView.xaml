<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SmartMovieBooking.Models"
             x:Class="SmartMovieBooking.Controls.ShowtimePillView">

    <Border StrokeThickness="0"
            Padding="12,10"
            StrokeShape="RoundRectangle 16">
        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BackgroundColor" Value="{DynamicResource ThemePrimaryContainer}" />
            </DataTrigger>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSurfaceContainerLow}" />
            </DataTrigger>
        </Border.Triggers>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
        <VerticalStackLayout Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{Binding StartTime}"
                       FontFamily="PlusJakartaBold"
                       FontSize="16"
                       TextColor="{DynamicResource ThemeOnSurface}" />
                <Label Grid.Column="1" Text="✓"
                       FontSize="16"
                       IsVisible="{Binding IsSelected}"
                       TextColor="{DynamicResource ThemeOnPrimary}" />
            </Grid>

            <Label Text="{Binding Format}"
                   FontFamily="InterSemiBold"
                   FontSize="11"
                   TextColor="{DynamicResource ThemePrimary}" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <Label Grid.Column="0"
                       Text="{Binding Price, StringFormat='${0:F2}'}"
                       FontFamily="PlusJakartaBold"
                       FontSize="11"
                       TextColor="{DynamicResource ThemePrimary}" />
                <Label Grid.Column="1"
                       Text="{Binding Status, Converter={StaticResource ShowtimeStatusToTextConverter}}"
                       FontFamily="InterSemiBold"
                       FontSize="10"
                       TextColor="{Binding Status, Converter={StaticResource ShowtimeStatusToColorConverter}}" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>