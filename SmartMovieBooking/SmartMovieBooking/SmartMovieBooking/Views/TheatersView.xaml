<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:syncfusionButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:syncfusionCards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
             xmlns:vm="clr-namespace:SmartMovieBooking.ViewModels"
             xmlns:models="clr-namespace:SmartMovieBooking.Models"
             xmlns:controls="clr-namespace:SmartMovieBooking.Views"
             xmlns:behaviors="clr-namespace:SmartMovieBooking.Behaviors"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="SmartMovieBooking.Views.TheatersView"
             x:DataType="vm:TheatersViewModel"
             Title="Theaters">

    <Grid RowDefinitions="{OnIdiom Default='*,Auto', Phone='*,72'}"
          ColumnDefinitions="{OnIdiom Default='200,*', Phone='*'}">
        <controls:AppSideBar Grid.Row="{OnIdiom Default=0, Phone=1}"
                             ActiveTab="Theaters" />

        <Grid MaximumWidthRequest="1200"
              Grid.Row="{OnIdiom Default=0, Phone=0}"
              Grid.Column="{OnIdiom Default='1', Phone='0'}"
              RowDefinitions="Auto,*"
              Padding="{OnIdiom Default='24', Phone='12'}"
              RowSpacing="16">
            <Border Grid.Row="0"
                    Background="#FFFFFF"
                    Stroke="#E6EAF9"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 28"
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="#1A235218"
                            Offset="0,10"
                            Radius="24"
                            Opacity="0.16" />
                </Border.Shadow>

                <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="20">
                    <Border WidthRequest="180"
                            HeightRequest="248"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 24"
                            BackgroundColor="#1A1A2E">
                        <Grid>
                            <Image Source="{Binding MovieBannerUrl}"
                                   Aspect="AspectFill"
                                   Opacity="0.78" />
                            <Border Background="#401A1A2E"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 24" />
                            <VerticalStackLayout Padding="14"
                                                 VerticalOptions="Fill"
                                                 Spacing="8">
                                <Border Background="#FFFFFF1A"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 999"
                                        Padding="10,5"
                                        HorizontalOptions="Start">
                                    <Label Text="{Binding MovieCertificateText, FallbackValue='PG-13'}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="10"
                                           TextColor="#FFFFFF" />
                                </Border>
                                <Label Text="{Binding MovieFormatText, FallbackValue='Dolby Cinema'}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="11"
                                       TextColor="#E8EAFB" />
                                <Label Text="{Binding MovieRatingText, FallbackValue='4.9'}"
                                       FontFamily="OpenSansSemibold"
                                       FontAttributes="Bold"
                                       FontSize="24"
                                       TextColor="#FFFFFF" />
                                <Label Text="Featured Movie"
                                       FontSize="11"
                                       TextColor="#D7DAF3" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="12" VerticalOptions="Center">
                        <Border Background="#EEF2FF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 999"
                                Padding="12,6"
                                HorizontalOptions="Start">
                            <Label Text="NOW SHOWING"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="10"
                                   CharacterSpacing="1.4"
                                   TextColor="#4338CA" />
                        </Border>
                        <Label Text="{Binding MovieTitle, FallbackValue='Choose a movie'}"
                               FontFamily="OpenSansSemibold"
                               FontSize="34"
                               FontAttributes="Bold"
                               LineBreakMode="WordWrap"
                               TextColor="#111827" />
                        <Label Text="{Binding MovieTagline}"
                               FontSize="14"
                               LineBreakMode="WordWrap"
                               TextColor="#4B5563" />
                        <HorizontalStackLayout Spacing="8">
                            <Border Background="#F4F7FF" StrokeThickness="0" StrokeShape="RoundRectangle 999" Padding="12,7">
                                <Label Text="{Binding MovieReleaseText, FallbackValue='Release'}" FontSize="11" TextColor="#4C51BF" />
                            </Border>
                            <Border Background="#F4F7FF" StrokeThickness="0" StrokeShape="RoundRectangle 999" Padding="12,7">
                                <Label Text="{Binding MovieDurationText, FallbackValue='2h 48m'}" FontSize="11" TextColor="#4C51BF" />
                            </Border>
                            <Border Background="#F4F7FF" StrokeThickness="0" StrokeShape="RoundRectangle 999" Padding="12,7">
                                <Label Text="{Binding MoviePriceRangeText, FallbackValue='From $18.50'}" FontSize="11" TextColor="#4C51BF" />
                            </Border>
                        </HorizontalStackLayout>
                        <Label Text="{Binding MovieSynopsis}"
                               FontSize="13"
                               LineBreakMode="TailTruncation"
                               MaxLines="3"
                               TextColor="#6B7280" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="2"
                                         Spacing="12"
                                         VerticalOptions="Center">
                        <Border Background="#F8FAFF"
                                Stroke="#DCE3F5"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="14"
                                HorizontalOptions="End">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="End">
                                <Label Text="CHANGE MOVIE"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="10"
                                       CharacterSpacing="1.4"
                                       TextColor="#6B7280"
                                       HorizontalTextAlignment="End" />
                                <Label Text="Currently browsing"
                                       FontSize="12"
                                       TextColor="#111827"
                                       HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Background="#3525CD"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18"
                                Padding="14"
                                HorizontalOptions="End">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="End">
                                <Label Text="14 theaters showing today"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="11"
                                       TextColor="#FFFFFF"
                                       HorizontalTextAlignment="End" />
                                <Label Text="Select a theater to continue"
                                       FontSize="12"
                                       TextColor="#E9E7FF"
                                       HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>
			<ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="16">
					<syncfusion:SfListView Grid.Row="1"
											ItemsSource="{Binding Theaters}"
                                           ItemSpacing="{OnIdiom Default=12, Phone=10}"
                                           AutoFitMode="DynamicHeight"
										   IsScrollingEnabled="False"
										   ScrollBarVisibility="Never"
                                           BackgroundColor="Transparent"
                                           SelectionMode="None">
                        <syncfusion:SfListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Theater">
								<Grid RowDefinitions="{OnIdiom Default=230, Phone=185}">
                                    <syncfusionCards:SfCardView CornerRadius="16"
                                                                BackgroundColor="#FFFFFF"
                                                                Padding="{OnIdiom Default=20, Phone=14}">
                                        <VerticalStackLayout Spacing="14">
                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                  ColumnSpacing="12">
                                                <Border Grid.Column="0"
                                                        WidthRequest="48"
                                                        HeightRequest="48"
                                                        StrokeShape="RoundRectangle 12"
                                                        BackgroundColor="#F1F2F8">
                                                    <Label Text="{Binding Icon, FallbackValue='🎬'}"
                                                           FontSize="22"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1"
                                                                     Spacing="2"
                                                                     VerticalOptions="Center">
                                                    <Label Text="{Binding Name}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontAttributes="Bold"
                                                           FontSize="15"
                                                           TextColor="#1A1A2E" />
                                                    <Label Text="{Binding Location}"
                                                           FontSize="11"
                                                           TextColor="#49454F" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="2"
                                                                     HorizontalOptions="End">
                                                    <Label Text="{Binding PriceFrom, StringFormat='From {0}'}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontAttributes="Bold"
                                                           FontSize="13"
                                                           TextColor="#3525CD"
                                                           HorizontalTextAlignment="End" />
                                                    <Label Text="{Binding AvailableSeats, StringFormat='{0} seats'}"
                                                           FontSize="10"
                                                           TextColor="#7A7B8C"
                                                           HorizontalTextAlignment="End" />
                                                </VerticalStackLayout>
                                            </Grid>

                                            <Label Text="SELECT SCREENING TIME"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="10"
                                                   TextColor="#7A7B8C" />

											<syncfusion:SfListView ItemsSource="{Binding Showtimes}"
																   ItemSpacing="{OnIdiom Default='8', Phone='4'}"
																   BackgroundColor="Transparent"
																   Orientation="Horizontal"
																   HeightRequest="{OnIdiom Default='76', Phone='62'}"
																   ScrollBarVisibility="Never"
																   AutoFitMode="DynamicHeight"
																   SelectionMode="None">
												<syncfusion:SfListView.ItemsLayout>
													<syncfusion:GridLayout SpanCount="1" />
												</syncfusion:SfListView.ItemsLayout>
												<syncfusion:SfListView.ItemTemplate>
													<DataTemplate x:DataType="models:Showtime">
														<syncfusionCards:SfCardView CornerRadius="14"
																					BackgroundColor="#F1F2F8"
																					Padding="{OnIdiom Default='12,8', Phone='10,8'}">
															<syncfusionCards:SfCardView.GestureRecognizers>
																<TapGestureRecognizer Tapped="OnShowtimeTapped"
																					  CommandParameter="{Binding .}" />
															</syncfusionCards:SfCardView.GestureRecognizers>
															<syncfusionCards:SfCardView.Behaviors>
																<behaviors:HoverAnimationBehavior />
															</syncfusionCards:SfCardView.Behaviors>
															<HorizontalStackLayout>
																<VerticalStackLayout Spacing="2"
																					 WidthRequest="80">
																	<Label Text="{Binding StartTime}"
																		   FontFamily="OpenSansSemibold"
																		   FontAttributes="Bold"
																		   FontSize="13"
																		   TextColor="#1A1A2E" />
																	<Label Text="{Binding Format}"
																		   FontFamily="OpenSansSemibold"
																		   FontSize="9"
																		   TextColor="#3525CD" />
																</VerticalStackLayout>
																<VerticalStackLayout Spacing="2"
																					 WidthRequest="80">
																	<Label Text="{Binding Price, StringFormat='${0:F2}'}"
																		   HorizontalOptions="End"
																		   FontFamily="OpenSansSemibold"
																		   FontAttributes="Bold"
																		   FontSize="13"
																		   TextColor="#3525CD" />
																	<Label Text="{Binding Status, Converter={StaticResource ShowtimeStatusLabelConverter}}"
																		   HorizontalOptions="End"
																		   FontFamily="OpenSansSemibold"
																		   FontSize="9"
																		   TextColor="{Binding Status, Converter={StaticResource ShowtimeStatusColorConverter}}" />
																</VerticalStackLayout>
															</HorizontalStackLayout>
														</syncfusionCards:SfCardView>
													</DataTemplate>
												</syncfusion:SfListView.ItemTemplate>
											</syncfusion:SfListView>
										</VerticalStackLayout>
                                    </syncfusionCards:SfCardView>
                                </Grid>
                            </DataTemplate>
                        </syncfusion:SfListView.ItemTemplate>
                    </syncfusion:SfListView>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
