<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:popup="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup"
             xmlns:syncfusionCards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
             xmlns:syncfusionButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:barcode="clr-namespace:Syncfusion.Maui.Barcode;assembly=Syncfusion.Maui.Barcode"
             xmlns:vm="clr-namespace:SmartMovieBooking.ViewModels"
             x:Class="SmartMovieBooking.Views.PaymentConfirmationView"
             x:DataType="vm:PaymentConfirmationViewModel"
             Title="Booking Confirmed"
             BackgroundColor="#0B1020">
    <Grid>
        <Border Background="#0B1020" />

        <popup:SfPopup x:Name="ConfirmationPopup"
                       IsOpen="True"
                       ShowCloseButton="False"
                       ShowFooter="False"
                       ShowHeader="False"
                       ShowOverlay="True"
                       AutoSizeMode="Both"
                       PlacementMode="Center"
                       BackgroundColor="Transparent">
            <popup:SfPopup.Content>
                    <Border WidthRequest="720"
                            MaximumWidthRequest="720"
                            Stroke="#DCE3F5"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 28"
                            Background="#F7F9FF"
                            Padding="24">
                        <Border.Shadow>
                            <Shadow Brush="#1A235220"
                                    Offset="0,14"
                                    Radius="30"
                                    Opacity="0.24" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="20">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="8">
                                    <Border Background="#EEF3FF"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 999"
                                            Padding="12,6"
                                            HorizontalOptions="Start">
                                        <Label Text="PAYMENT COMPLETE"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="10"
                                               CharacterSpacing="1.6"
                                               TextColor="#4A3DE0" />
                                    </Border>

                                    <Label Text="Booking Confirmed!"
                                           FontFamily="OpenSansSemibold"
                                           FontAttributes="Bold"
                                           FontSize="28"
                                           TextColor="#17182B" />
                                    <Label Text="Your tickets have been booked successfully."
                                           FontSize="14"
                                           TextColor="#5C5F76" />
                                </VerticalStackLayout>

                                <Grid HeightRequest="96"
                                      WidthRequest="96"
                                      HorizontalOptions="End"
                                      VerticalOptions="Start">
                                    <Ellipse Fill="#9DEAF6"
                                             WidthRequest="96"
                                             HeightRequest="96" />
                                    <Label Text="✓"
                                           FontSize="48"
                                           FontFamily="OpenSansSemibold"
                                           FontAttributes="Bold"
                                           TextColor="#062A33"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Grid>
                            </Grid>

                            <syncfusionCards:SfCardView CornerRadius="24"
                                                        BackgroundColor="#FFFFFF"
                                                        Padding="18">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="BOOKING ID"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="10"
                                               TextColor="#7A7B8C" />
                                        <Label x:Name="BookingIdLabel"
                                               Text="BK-000000"
                                               FontFamily="OpenSansSemibold"
                                               FontAttributes="Bold"
                                               FontSize="18"
                                               TextColor="#1A1A2E" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                                        <Label Text="TOTAL PAID"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="10"
                                               TextColor="#7A7B8C" />
                                        <Label x:Name="TotalLabel"
                                               Text="$0.00"
                                               FontFamily="OpenSansSemibold"
                                               FontAttributes="Bold"
                                               FontSize="18"
                                               TextColor="#3525CD" />
                                    </VerticalStackLayout>
                                </Grid>
                            </syncfusionCards:SfCardView>

                            <syncfusionCards:SfCardView CornerRadius="24"
                                                        BackgroundColor="#FFFFFF"
                                                        Padding="18">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="10">
                                    <Label Text="TICKET DETAILS"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="10"
                                           TextColor="#7A7B8C" />

                                    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16">
                                        <VerticalStackLayout Spacing="8">
                                            <Label x:Name="MovieTitleLabel"
                                                   Text=""
                                                   FontFamily="OpenSansSemibold"
                                                   FontAttributes="Bold"
                                                   FontSize="16"
                                                   TextColor="#1A1A2E" />
                                            <Label x:Name="TheaterLabel"
                                                   Text=""
                                                   FontSize="12"
                                                   TextColor="#49454F" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                                            <Label x:Name="ShowtimeLabel"
                                                   Text=""
                                                   FontSize="12"
                                                   TextColor="#49454F" />
                                            <Label x:Name="SeatsLabel"
                                                   Text=""
                                                   FontSize="12"
                                                   TextColor="#49454F" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <barcode:SfBarcodeGenerator Grid.Column="1"
                                                                Grid.RowSpan="2"
                                                                Value="Barcode"
                                                                ShowText="False"
                                                                WidthRequest="96"
                                                                HeightRequest="96"
                                                                HorizontalOptions="End">
                                        <barcode:SfBarcodeGenerator.Symbology>
                                            <barcode:QRCode />
                                        </barcode:SfBarcodeGenerator.Symbology>
                                    </barcode:SfBarcodeGenerator>
                                </Grid>
                            </syncfusionCards:SfCardView>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <syncfusionButtons:SfButton Text="Back to Home"
                                                             BackgroundColor="#3525CD"
                                                             TextColor="#FFFFFF"
                                                             CornerRadius="14"
                                                             FontFamily="OpenSansSemibold"
                                                             HeightRequest="48"
                                                             Clicked="OnDoneClicked" />
                                <syncfusionButtons:SfButton Grid.Column="1"
                                                             Text="View My Bookings"
                                                             BackgroundColor="#FFFFFF"
                                                             TextColor="#3525CD"
                                                             Stroke="#D7DDF1"
                                                             StrokeThickness="1"
                                                             CornerRadius="14"
                                                             FontFamily="OpenSansSemibold"
                                                             FontAttributes="Bold"
                                                             HeightRequest="48"
                                                             Clicked="OnViewBookingsClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
            </popup:SfPopup.Content>
        </popup:SfPopup>
    </Grid>
</ContentPage>
