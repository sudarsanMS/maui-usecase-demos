<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Color tokens extracted directly from the Stitch design.
        Light theme is the default (matches Material 3 baseline).
        Dark theme overrides are applied at runtime by ThemeService.
    -->

    <!-- ====== Light Theme Tokens ====== -->
    <Color x:Key="PrimaryLight">#3525CD</Color>
    <Color x:Key="PrimaryContainerLight">#4F46E5</Color>
    <Color x:Key="OnPrimaryLight">#FFFFFF</Color>
    <Color x:Key="OnPrimaryContainerLight">#FFFFFF</Color>

    <Color x:Key="SecondaryLight">#712AE2</Color>
    <Color x:Key="SecondaryContainerLight">#E9DDFC</Color>
    <Color x:Key="OnSecondaryLight">#FFFFFF</Color>
    <Color x:Key="OnSecondaryContainerLight">#1F1147</Color>

    <Color x:Key="TertiaryLight">#00505F</Color>
    <Color x:Key="TertiaryContainerLight">#9DEAF6</Color>
    <Color x:Key="OnTertiaryLight">#FFFFFF</Color>
    <Color x:Key="OnTertiaryContainerLight">#002A33</Color>

    <Color x:Key="ErrorLight">#BA1A1A</Color>
    <Color x:Key="OnErrorLight">#FFFFFF</Color>

    <Color x:Key="BackgroundLight">#F8F9FF</Color>
    <Color x:Key="OnBackgroundLight">#1A1A2E</Color>

    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="OnSurfaceLight">#1A1A2E</Color>
    <Color x:Key="OnSurfaceVariantLight">#49454F</Color>

    <Color x:Key="SurfaceContainerLowestLight">#FFFFFF</Color>
    <Color x:Key="SurfaceContainerLowLight">#F1F2F8</Color>
    <Color x:Key="SurfaceContainerLight">#ECEDF6</Color>
    <Color x:Key="SurfaceContainerHighLight">#E5E6F1</Color>
    <Color x:Key="SurfaceContainerHighestLight">#DFE0EC</Color>

    <Color x:Key="OutlineLight">#7A7B8C</Color>
    <Color x:Key="OutlineVariantLight">#CAC7D0</Color>

    <Color x:Key="InverseSurfaceLight">#2F2F44</Color>
    <Color x:Key="InverseOnSurfaceLight">#F1F2F8</Color>

    <Color x:Key="SecondaryFixedLight">#FFB703</Color>
    <Color x:Key="SecondaryFixedDimLight">#E89A00</Color>

    <Color x:Key="SuccessLight">#1E7F4F</Color>
    <Color x:Key="AmberLight">#B45309</Color>

    <!-- ====== Dark Theme Tokens ====== -->
    <Color x:Key="PrimaryDark">#8E84FF</Color>
    <Color x:Key="PrimaryContainerDark">#5B4FE0</Color>
    <Color x:Key="OnPrimaryDark">#1F1147</Color>
    <Color x:Key="OnPrimaryContainerDark">#E9DDFC</Color>

    <Color x:Key="SecondaryDark">#B59CFF</Color>
    <Color x:Key="SecondaryContainerDark">#4A2EAE</Color>
    <Color x:Key="OnSecondaryDark">#1F1147</Color>
    <Color x:Key="OnSecondaryContainerDark">#E9DDFC</Color>

    <Color x:Key="TertiaryDark">#6DD2E5</Color>
    <Color x:Key="TertiaryContainerDark">#003543</Color>
    <Color x:Key="OnTertiaryDark">#001F26</Color>
    <Color x:Key="OnTertiaryContainerDark">#9DEAF6</Color>

    <Color x:Key="ErrorDark">#FFB4AB</Color>
    <Color x:Key="OnErrorDark">#690005</Color>

    <Color x:Key="BackgroundDark">#12131F</Color>
    <Color x:Key="OnBackgroundDark">#E5E6F1</Color>

    <Color x:Key="SurfaceDark">#1A1B2E</Color>
    <Color x:Key="OnSurfaceDark">#E5E6F1</Color>
    <Color x:Key="OnSurfaceVariantDark">#CAC7D0</Color>

    <Color x:Key="SurfaceContainerLowestDark">#0E0F1A</Color>
    <Color x:Key="SurfaceContainerLowDark">#1F2034</Color>
    <Color x:Key="SurfaceContainerDark">#23243A</Color>
    <Color x:Key="SurfaceContainerHighDark">#2D2E45</Color>
    <Color x:Key="SurfaceContainerHighestDark">#383952</Color>

    <Color x:Key="OutlineDark">#9495A8</Color>
    <Color x:Key="OutlineVariantDark">#49454F</Color>

    <Color x:Key="InverseSurfaceDark">#E5E6F1</Color>
    <Color x:Key="InverseOnSurfaceDark">#2F2F44</Color>

    <Color x:Key="SecondaryFixedDark">#FFB703</Color>
    <Color x:Key="SecondaryFixedDimDark">#E89A00</Color>

    <Color x:Key="SuccessDark">#5DD193</Color>
    <Color x:Key="AmberDark">#FBBF24</Color>

    <!-- ====== Gradients (Stitch uses these in the AI FAB) ====== -->
    <LinearGradientBrush x:Key="PrimaryToSecondaryContainerGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource PrimaryLight}" Offset="0.0" />
        <GradientStop Color="{StaticResource SecondaryContainerLight}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ====== Status helpers ====== -->
    <Color x:Key="SeatAvailable">#E5E6F1</Color>
    <Color x:Key="SeatOccupied">#9CA3AF</Color>
    <Color x:Key="SeatSelected">#3525CD</Color>
    <Color x:Key="SeatPremium">#FFB703</Color>
</ResourceDictionary>