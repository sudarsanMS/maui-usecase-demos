<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Theme.xaml holds the alias keys used throughout the app.
        They map to either Light or Dark variants depending on the
        active theme. ThemeService.UpdateTheme() rewrites these
        values at runtime.
    -->

    <Color x:Key="ThemePrimary">#3525CD</Color>
    <Color x:Key="ThemePrimaryContainer">#4F46E5</Color>
    <Color x:Key="ThemeOnPrimary">#FFFFFF</Color>
    <Color x:Key="ThemeOnPrimaryContainer">#FFFFFF</Color>

    <Color x:Key="ThemeSecondary">#712AE2</Color>
    <Color x:Key="ThemeSecondaryContainer">#E9DDFC</Color>
    <Color x:Key="ThemeOnSecondary">#FFFFFF</Color>
    <Color x:Key="ThemeOnSecondaryContainer">#1F1147</Color>

    <Color x:Key="ThemeTertiary">#00505F</Color>
    <Color x:Key="ThemeTertiaryContainer">#9DEAF6</Color>
    <Color x:Key="ThemeOnTertiary">#FFFFFF</Color>
    <Color x:Key="ThemeOnTertiaryContainer">#002A33</Color>

    <Color x:Key="ThemeError">#BA1A1A</Color>
    <Color x:Key="ThemeOnError">#FFFFFF</Color>

    <Color x:Key="ThemeBackground">#F8F9FF</Color>
    <Color x:Key="ThemeOnBackground">#1A1A2E</Color>

    <Color x:Key="ThemeSurface">#FFFFFF</Color>
    <Color x:Key="ThemeOnSurface">#1A1A2E</Color>
    <Color x:Key="ThemeOnSurfaceVariant">#49454F</Color>

    <Color x:Key="ThemeSurfaceContainerLowest">#FFFFFF</Color>
    <Color x:Key="ThemeSurfaceContainerLow">#F1F2F8</Color>
    <Color x:Key="ThemeSurfaceContainer">#ECEDF6</Color>
    <Color x:Key="ThemeSurfaceContainerHigh">#E5E6F1</Color>
    <Color x:Key="ThemeSurfaceContainerHighest">#DFE0EC</Color>

    <Color x:Key="ThemeOutline">#7A7B8C</Color>
    <Color x:Key="ThemeOutlineVariant">#CAC7D0</Color>

    <Color x:Key="ThemeInverseSurface">#2F2F44</Color>
    <Color x:Key="ThemeInverseOnSurface">#F1F2F8</Color>

    <Color x:Key="ThemeSecondaryFixed">#FFB703</Color>
    <Color x:Key="ThemeSecondaryFixedDim">#E89A00</Color>

    <Color x:Key="ThemeSuccess">#1E7F4F</Color>
    <Color x:Key="ThemeAmber">#B45309</Color>
</ResourceDictionary>