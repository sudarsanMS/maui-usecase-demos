<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Card pattern from Stitch: bg-surface-container-lowest, rounded-2xl
        (1rem = 16px), p-space-lg, shadow-sm.
    -->

    <Style TargetType="Border" x:Key="SurfaceCard">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerLowestLight}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#1A000000" Offset="0,1" Radius="2" Opacity="0.06" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="SurfaceCardTight">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerLowestLight}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#1A000000" Offset="0,1" Radius="2" Opacity="0.06" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="PanelCard">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerLowestLight}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#1A000000" Offset="0,1" Radius="2" Opacity="0.06" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small "tile" used for top-rated venue cards -->
    <Style TargetType="Border" x:Key="TileCard">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerLowestLight}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#1A000000" Offset="0,1" Radius="2" Opacity="0.06" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon tile used in theater card headers -->
    <Style TargetType="Border" x:Key="IconTile">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerLowLight}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>