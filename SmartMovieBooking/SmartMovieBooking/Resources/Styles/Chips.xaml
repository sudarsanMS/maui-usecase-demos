<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Chip patterns from Stitch: rounded-full (pill), two variants:
          - Primary (selected)  : primary-container background, on-primary text
          - Inactive (default)  : surface-container-low background, on-surface text
    -->

    <Style TargetType="Border" x:Key="ChipBase">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="16,4" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="999" />
            </Setter.Value>
        </Setter>
        <Setter Property="HeightRequest" Value="28" />
    </Style>

    <Style TargetType="Border" x:Key="PrimaryChip" BasedOn="{StaticResource ChipBase}">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainerLight}" />
    </Style>

    <Style TargetType="Border" x:Key="InactiveChip" BasedOn="{StaticResource ChipBase}">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerLowLight}" />
    </Style>

    <Style TargetType="Border" x:Key="TertiaryContainerChip" BasedOn="{StaticResource ChipBase}">
        <Setter Property="BackgroundColor" Value="{DynamicResource TertiaryContainerLight}" />
    </Style>

    <Style TargetType="Border" x:Key="SecondaryContainerChip" BasedOn="{StaticResource ChipBase}">
        <Setter Property="BackgroundColor" Value="{DynamicResource SecondaryContainerLight}" />
    </Style>

    <Style TargetType="Border" x:Key="InverseSurfaceChip" BasedOn="{StaticResource ChipBase}">
        <Setter Property="BackgroundColor" Value="{DynamicResource InverseSurfaceLight}" />
    </Style>

    <Style TargetType="Border" x:Key="PrimeTimeBadge">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerLowestLight}" />
        <Setter Property="Opacity" Value="0.2" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="4" />
            </Setter.Value>
        </Setter>
        <Setter Property="HeightRequest" Value="16" />
    </Style>

    <Style TargetType="Label" x:Key="ChipLabel">
        <Setter Property="FontFamily" Value="PlusJakartaSemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="ChipLabelOnPrimary" BasedOn="{StaticResource ChipLabel}">
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryLight}" />
    </Style>

    <Style TargetType="Label" x:Key="ChipLabelOnSurface" BasedOn="{StaticResource ChipLabel}">
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceLight}" />
    </Style>
</ResourceDictionary>