<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Button styles. Stitch uses rounded-xl (0.75rem = 12px) with
        a primary brand color background and white text.
    -->

    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryLight}" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryLight}" />
        <Setter Property="FontFamily" Value="PlusJakartaSemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainerLight}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="OutlinedButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryLight}" />
        <Setter Property="FontFamily" Value="PlusJakartaSemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderColor" Value="{DynamicResource OutlineLight}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>

    <Style TargetType="Button" x:Key="GhostButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceLight}" />
        <Setter Property="FontFamily" Value="PlusJakartaSemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HeightRequest" Value="36" />
    </Style>

    <!-- Round icon buttons used in the header, FAB, etc. -->
    <Style TargetType="Button" x:Key="IconButton">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerLowestLight}" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantLight}" />
        <Setter Property="FontFamily" Value="MaterialSymbolsOutlined" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>

    <Style TargetType="Button" x:Key="WindowControlButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantLight}" />
        <Setter Property="FontFamily" Value="MaterialSymbolsOutlined" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="WidthRequest" Value="46" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Button" x:Key="CloseWindowButton" BasedOn="{StaticResource WindowControlButton}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#E81123" />
                            <Setter Property="TextColor" Value="White" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
</ResourceDictionary>