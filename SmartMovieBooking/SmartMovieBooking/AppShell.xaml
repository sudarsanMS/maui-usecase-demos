<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:SmartMovieBooking.Views"
       x:Class="SmartMovieBooking.AppShell"
       Title="Smart Movie Ticket Booking"
       Shell.NavBarIsVisible="False"
       Shell.TabBarIsVisible="False">

    <Shell.ControlTemplate>
        <ControlTemplate>
            <Grid RowDefinitions="{OnIdiom Default='*', Phone='*,72'}"
                  ColumnDefinitions="{OnIdiom Default='200,*', Phone='*'}"
                  BackgroundColor="#F6F7FB">

                <views:AppSideBar Grid.Row="{OnIdiom Default=0, Phone=1}"
                                  ActiveTab="Movies" />

                <Grid Grid.Row="{OnIdiom Default=0, Phone=0}"
                      Grid.Column="{OnIdiom Default=1, Phone=0}">
                    <ScrollView>
                        <ContentPresenter />
                    </ScrollView>
                </Grid>
            </Grid>
        </ControlTemplate>
    </Shell.ControlTemplate>

    <ShellContent Route="home"
                  ContentTemplate="{DataTemplate views:MovieHomeView}" />
</Shell>