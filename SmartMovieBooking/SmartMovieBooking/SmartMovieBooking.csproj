<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Windows-only target per the Stitch design (desktop sidebar + title bar layout).
		     Multi-targeting (Android/iOS/Mac) was attempted in Phase 4 but caused
		     restore failures on Windows. Add mobile TFMs back once the Windows
		     build is verified working on your machine. -->
		<TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>SmartMovieBooking</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Explicitly set ProjectName and AssemblyName so NuGet 6.x+ restore
		     doesn't fail with "Missing required property 'ProjectName'". -->
		<ProjectName>SmartMovieBooking</ProjectName>
		<AssemblyName>SmartMovieBooking</AssemblyName>
		<LangVersion>latest</LangVersion>

		<!-- Display name -->
		<ApplicationTitle>Smart Movie Ticket Booking</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.syncfusion.smartmoviebooking</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>2.5</ApplicationDisplayVersion>
		<ApplicationVersion>25</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#3525CD" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#3525CD" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts (sample uses system fallbacks; TTF files added manually later) -->
		<!-- <MauiFont Include="Resources\Fonts\*" /> -->
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9" />

		<!-- Syncfusion MAUI suite -->
		<PackageReference Include="Syncfusion.Maui.Core" Version="33.2.15" />
		<PackageReference Include="Syncfusion.Maui.ListView" Version="33.2.15" />
		<PackageReference Include="Syncfusion.Maui.Buttons" Version="33.2.15" />
		<PackageReference Include="Syncfusion.Maui.AIAssistView" Version="33.2.15" />
		<PackageReference Include="Syncfusion.Maui.Cards" Version="33.2.15" />
		<PackageReference Include="Syncfusion.Maui.Chips" Version="33.2.15" />
		<PackageReference Include="Syncfusion.Maui.TabView" Version="33.2.15" />
		<PackageReference Include="Syncfusion.Maui.RadialMenu" Version="33.2.15" />
	</ItemGroup>

</Project>
