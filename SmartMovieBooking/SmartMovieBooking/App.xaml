<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SmartMovieBooking"
             xmlns:conv="clr-namespace:SmartMovieBooking.Converters"
             xmlns:syncTheme="clr-namespace:Syncfusion.Maui.Themes;assembly=Syncfusion.Maui.Core"
             x:Class="SmartMovieBooking.App"
             UserAppTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Typography.xaml" />
                <ResourceDictionary Source="Resources/Styles/Buttons.xaml" />
                <ResourceDictionary Source="Resources/Styles/Chips.xaml" />
                <ResourceDictionary Source="Resources/Styles/Cards.xaml" />
                <ResourceDictionary Source="Resources/Styles/Theme.xaml" />
                <syncTheme:SyncfusionThemeResourceDictionary VisualTheme="MaterialLight"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global value converters -->
            <conv:EnumToVisibilityConverter x:Key="PageVisibleConverter" />
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
            <conv:CountToBoolConverter x:Key="CountToBoolConverter" />
            <conv:CountToInverseBoolConverter x:Key="CountToInverseBoolConverter" />
            <conv:SelectedToBackgroundConverter x:Key="SelectedBgConverter" />
            <conv:SelectedToForegroundConverter x:Key="SelectedFgConverter" />
            <conv:DateToLabelConverter x:Key="DateToLabelConverter" />
            <conv:ShowtimeStatusToColorConverter x:Key="ShowtimeStatusToColorConverter" />
            <conv:ShowtimeStatusToTextConverter x:Key="ShowtimeStatusToTextConverter" />
            <conv:SeatStateToColorConverter x:Key="SeatStateToColorConverter" />
            <conv:SeatTierToBorderColorConverter x:Key="SeatTierToBorderColorConverter" />
            <conv:StringEqualsConverter x:Key="StringEqualsConverter" />
            <conv:TitleCaseConverter x:Key="TitleCaseConverter" />
            <conv:FormatToTimeConverter x:Key="FormatToTimeConverter" />
            <conv:NotNullConverter x:Key="NotNullConverter" />
            <conv:IsNullConverter x:Key="IsNullConverter" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
            <conv:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
            <conv:CurrencyConverter x:Key="CurrencyConverter" />
            <conv:StringToColorConverter x:Key="StringToColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>