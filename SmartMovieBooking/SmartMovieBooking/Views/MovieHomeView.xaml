<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:syncfusionButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:syncfusionCards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
             xmlns:vm="clr-namespace:SmartMovieBooking.ViewModels"
             xmlns:models="clr-namespace:SmartMovieBooking.Models"
             x:Class="SmartMovieBooking.Views.MovieHomeView"
             x:DataType="vm:HomeViewModel"
             Title="Movie Home">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <VerticalStackLayout Spacing="4">
                <Label Text="Discover Movies" FontFamily="OpenSansSemibold" FontSize="28"
                       FontAttributes="Bold" TextColor="#1A1A2E" />
                <Label Text="Find the perfect show · 10 movies in catalog"
                       FontSize="13" TextColor="#49454F" />
            </VerticalStackLayout>

            <!-- Search box wrapped in an SfCardView (replaces plain Border) -->
            <syncfusionCards:SfCardView CornerRadius="12"
                                         BackgroundColor="#F1F2F8"
                                         Padding="14,0"
                                         HeightRequest="44">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="🔍" FontSize="14" VerticalTextAlignment="Center" />
                    <Entry Grid.Column="1" x:Name="SearchEntry"
                           Placeholder="Search by title or genre…"
                           PlaceholderColor="#49454F"
                           BackgroundColor="Transparent"
                           TextChanged="OnSearchChanged" />
                </Grid>
            </syncfusionCards:SfCardView>

            <!-- Genre chip strip: built dynamically in code-behind -->
            <HorizontalStackLayout x:Name="GenreChipStrip" Spacing="8" />

            <!-- Loading indicator -->
            <ActivityIndicator x:Name="LoadingSpinner" IsRunning="True"
                               IsVisible="True" HorizontalOptions="Center"
                               Color="#3525CD" />

            <!-- Movie cards grid using SfListView (2-column Syncfusion layout) -->
            <syncfusion:SfListView x:Name="MoviesList"
                                   ItemsSource="{Binding FilteredMovies}"
                                   ItemSpacing="12"
                                   AutoFitMode="DynamicHeight"
                                   BackgroundColor="Transparent"
                                   SelectionMode="Single"
                                   SelectionChanged="OnMovieTapped">
                <syncfusion:SfListView.ItemsLayout>
                    <syncfusion:GridLayout SpanCount="2" />
                </syncfusion:SfListView.ItemsLayout>
                <syncfusion:SfListView.ItemTemplate>
                    <!-- NOTE: x:DataType deliberately omitted here. SfListView with
                         runtime inflator does not reliably resolve compiled bindings
                         on inner DataTemplates (XLS errors / silent empty bindings).
                         Without x:DataType the bindings resolve at runtime via
                         reflection against the DataContext, which is the Movie item. -->
                    <DataTemplate>
                        <syncfusionCards:SfCardView CornerRadius="16"
                                                     BackgroundColor="#FFFFFF"
                                                     Padding="0">
                            <syncfusionCards:SfCardView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMovieCardTapped"
                                                        CommandParameter="{Binding .}" />
                            </syncfusionCards:SfCardView.GestureRecognizers>
                            <VerticalStackLayout Spacing="0">
                                <!-- Poster area -->
                                <Grid HeightRequest="180" BackgroundColor="#E5E6F1">
                                    <Label Text="🎬" FontSize="56"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           TextColor="#7A7B8C" />
                                    <!-- Rating badge -->
                                    <Border BackgroundColor="#2F2F44"
                                            StrokeShape="RoundRectangle 999"
                                            Padding="8,3"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            Margin="0,8,8,0">
                                        <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                                            <Label Text="★" FontSize="10" TextColor="#FFB740" />
                                            <Label Text="{Binding Rating}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="10" TextColor="#F1F2F8" />
                                        </HorizontalStackLayout>
                                    </Border>
                                    <!-- Format chip -->
                                    <Border BackgroundColor="#4F46E5"
                                            StrokeShape="RoundRectangle 999"
                                            Padding="8,3"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Start"
                                            Margin="8,8,0,0">
                                        <Label Text="{Binding Format}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="10" TextColor="#FFFFFF" />
                                    </Border>
                                </Grid>
                                <!-- Card body -->
                                <VerticalStackLayout Padding="12" Spacing="4">
                                    <!-- Movie TITLE -->
                                    <Label Text="{Binding Title}"
                                           FontFamily="OpenSansSemibold"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1"
                                           TextColor="#1A1A2E" />
                                    <!-- Tagline -->
                                    <Label Text="{Binding Tagline}"
                                           FontSize="10"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2"
                                           TextColor="#49454F" />
                                    <!-- Genre · Duration · Certificate -->
                                    <HorizontalStackLayout Spacing="4" Margin="0,4,0,0">
                                        <Label Text="{Binding PrimaryGenre}"
                                               FontSize="9" TextColor="#7A7B8C"
                                               VerticalTextAlignment="Center" />
                                        <Label Text="·" FontSize="9" TextColor="#7A7B8C" />
                                        <Label Text="{Binding Duration}"
                                               FontSize="9" TextColor="#7A7B8C"
                                               VerticalTextAlignment="Center" />
                                        <Label Text="·" FontSize="9" TextColor="#7A7B8C" />
                                        <Label Text="{Binding Certificate}"
                                               FontSize="9" TextColor="#7A7B8C"
                                               VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                    <!-- Book Now button -->
                                    <syncfusionButtons:SfButton Text="Book Now"
                                                                 Background="#3525CD"
                                                                 TextColor="#FFFFFF"
                                                                 CornerRadius="10"
                                                                 HeightRequest="36"
                                                                 Margin="0,8,0,0"
                                                                 FontFamily="OpenSansSemibold"
                                                                 FontSize="12"
                                                                 HorizontalOptions="Fill"
                                                                 CommandParameter="{Binding .}"
                                                                 Clicked="OnBookNowClicked" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </syncfusionCards:SfCardView>
                    </DataTemplate>
                </syncfusion:SfListView.ItemTemplate>
                <syncfusion:SfListView.EmptyView>
                    <VerticalStackLayout Padding="40" Spacing="8" HorizontalOptions="Center">
                        <Label Text="🎞️" FontSize="48" HorizontalTextAlignment="Center" />
                        <Label Text="No movies match your filters"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               TextColor="#1A1A2E" />
                        <Label Text="Try clearing the search or selecting a different genre."
                               FontSize="11"
                               HorizontalTextAlignment="Center"
                               TextColor="#49454F" />
                    </VerticalStackLayout>
                </syncfusion:SfListView.EmptyView>
            </syncfusion:SfListView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>