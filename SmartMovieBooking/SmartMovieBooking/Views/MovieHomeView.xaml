<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:syncfusionButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:syncfusionCards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
             xmlns:vm="clr-namespace:SmartMovieBooking.ViewModels"
             xmlns:models="clr-namespace:SmartMovieBooking.Models"
             x:Class="SmartMovieBooking.Views.MovieHomeView"
             x:DataType="vm:HomeViewModel"
             Title="Movie Home">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <VerticalStackLayout Spacing="4">
                <Label Text="Discover Movies" FontFamily="OpenSansSemibold" FontSize="28"
                       FontAttributes="Bold" TextColor="#1A1A2E" />
                <Label Text="Find the perfect show · 10 movies in catalog"
                       FontSize="13" TextColor="#49454F" />
            </VerticalStackLayout>

            <!-- Search -->
            <syncfusionCards:SfCardView CornerRadius="12"
                                         BackgroundColor="#F1F2F8"
                                         StrokeColor="#CAC7D0"
                                         StrokeThickness="1"
                                         Padding="14,0"
                                         HeightRequest="44">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="🔍" FontSize="14" VerticalTextAlignment="Center" />
                    <Entry Grid.Column="1" x:Name="SearchEntry"
                           Placeholder="Search by title or genre…"
                           PlaceholderColor="#49454F"
                           BackgroundColor="Transparent"
                           TextChanged="OnSearchChanged" />
                </Grid>
            </syncfusionCards:SfCardView>

            <!-- Genre chip strip: built dynamically in code-behind to avoid
                 Syncfusion runtime-inflation issues with ChipLayout.FlexLayout -->
            <HorizontalStackLayout x:Name="GenreChipStrip" Spacing="8" />

            <!-- Activity indicator while loading -->
            <ActivityIndicator x:Name="LoadingSpinner" IsRunning="True"
                               IsVisible="True" HorizontalOptions="Center"
                               Color="#3525CD" />

            <!-- Movie cards grid using SfListView with GridLayout -->
            <syncfusion:SfListView x:Name="MoviesList"
                                   ItemsSource="{Binding FilteredMovies}"
                                   ItemSpacing="16"
                                   BackgroundColor="Transparent"
                                   SelectionMode="Single"
                                   SelectionChanged="OnMovieTapped">
                <syncfusion:SfListView.ItemsLayout>
                    <syncfusion:GridLayout SpanCount="3" />
                </syncfusion:SfListView.ItemsLayout>
                <syncfusion:SfListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Movie">
                        <syncfusionCards:SfCardView CornerRadius="16"
                                                     BackgroundColor="#FFFFFF"
                                                     StrokeThickness="0">
                            <VerticalStackLayout Spacing="0">
                                <!-- Poster area -->
                                <Grid HeightRequest="200" BackgroundColor="#E5E6F1">
                                    <Label Text="🎬" FontSize="56"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           TextColor="#7A7B8C" />
                                    <!-- Rating badge -->
                                    <Border BackgroundColor="#2F2F44"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 999"
                                            Padding="8,3"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            Margin="0,8,8,0">
                                        <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                                            <Label Text="★" FontSize="10" TextColor="#FFB740" />
                                            <Label Text="{Binding Rating}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="10" TextColor="#F1F2F8" />
                                        </HorizontalStackLayout>
                                    </Border>
                                    <!-- Format chip -->
                                    <Border BackgroundColor="#4F46E5" StrokeThickness="0" StrokeShape="RoundRectangle 999" Padding="8,3">
                                                <Label Text="·" FontFamily="OpenSansSemibold" FontSize="10" TextColor="#FFFFFF" />
                                              </Border>
                                </Grid>
                                <VerticalStackLayout Padding="12" Spacing="4">
                                    <Label Text="{Binding Title}"
                                           FontFamily="OpenSansSemibold"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1"
                                           TextColor="#1A1A2E" />
                                    <Label Text="{Binding Tagline}"
                                           FontSize="10"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2"
                                           TextColor="#49454F" />
                                    <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                                        <Label Text="{Binding Duration}"
                                               FontSize="9" TextColor="#7A7B8C"
                                               VerticalTextAlignment="Center" />
                                        <Label Text="·" FontSize="9" TextColor="#7A7B8C" />
                                        <Label Text="{Binding Certificate}"
                                               FontSize="9" TextColor="#7A7B8C"
                                               VerticalTextAlignment="Center" />
                                        <Label Text="·" FontSize="9" TextColor="#7A7B8C" />
                                        <Label Text="{Binding PrimaryGenre}"
                                               FontSize="9" TextColor="#7A7B8C"
                                               VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </syncfusionCards:SfCardView>
                    </DataTemplate>
                </syncfusion:SfListView.ItemTemplate>
                <syncfusion:SfListView.EmptyView>
                    <VerticalStackLayout Padding="40" Spacing="8" HorizontalOptions="Center">
                        <Label Text="🎞️" FontSize="48" HorizontalTextAlignment="Center" />
                        <Label Text="No movies match your filters"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               TextColor="#1A1A2E" />
                        <Label Text="Try clearing the search or selecting a different genre."
                               FontSize="11"
                               HorizontalTextAlignment="Center"
                               TextColor="#49454F" />
                    </VerticalStackLayout>
                </syncfusion:SfListView.EmptyView>
            </syncfusion:SfListView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
