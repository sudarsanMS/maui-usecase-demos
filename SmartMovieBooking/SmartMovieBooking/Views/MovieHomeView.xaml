<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:syncfusionButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:syncfusionCards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Core"
             xmlns:vm="clr-namespace:SmartMovieBooking.ViewModels"
             xmlns:models="clr-namespace:SmartMovieBooking.Models"
             x:Class="SmartMovieBooking.Views.MovieHomeView"
             x:DataType="vm:HomeViewModel"
             Title="Movie Home">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <VerticalStackLayout Spacing="4">
                <Label Text="Discover Movies" FontFamily="OpenSansSemibold" FontSize="28"
                       FontAttributes="Bold" TextColor="#1A1A2E" />
                <Label Text="Find the perfect show · 10 movies in catalog"
                       FontSize="13" TextColor="#49454F" />
            </VerticalStackLayout>

            <!-- Search -->
            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="#F1F2F8"
                    Padding="14,0"
                    HeightRequest="44">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="🔍" FontSize="14" VerticalTextAlignment="Center" />
                    <Entry Grid.Column="1" x:Name="SearchEntry"
                           Placeholder="Search by title or genre…"
                           PlaceholderColor="#49454F"
                           BackgroundColor="Transparent"
                           TextChanged="OnSearchChanged" />
                </Grid>
            </Border>

            <!-- Genre chip strip: built dynamically in code-behind -->
            <HorizontalStackLayout x:Name="GenreChipStrip" Spacing="8" />

            <!-- Loading indicator -->
            <ActivityIndicator x:Name="LoadingSpinner" IsRunning="True"
                               IsVisible="True" HorizontalOptions="Center"
                               Color="#3525CD" />

            <!-- Movie cards: use plain CollectionView for reliable bindings.
                 Each card uses a TapGestureRecognizer that targets the whole
                 card and navigates to the Theaters page. -->
            <CollectionView x:Name="MoviesList"
                            ItemsSource="{Binding FilteredMovies}"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2"
                                     HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Movie">
                        <Border StrokeShape="RoundRectangle 16"
                                BackgroundColor="#FFFFFF"
                                Padding="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMovieCardTapped"
                                                        CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="0">
                                <!-- Poster area -->
                                <Grid HeightRequest="180" BackgroundColor="#E5E6F1">
                                    <Label Text="🎬" FontSize="56"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           TextColor="#7A7B8C" />
                                    <!-- Rating badge -->
                                    <Border BackgroundColor="#2F2F44"
                                            StrokeShape="RoundRectangle 999"
                                            Padding="8,3"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            Margin="0,8,8,0">
                                        <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                                            <Label Text="★" FontSize="10" TextColor="#FFB740" />
                                            <Label Text="{Binding Rating}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="10" TextColor="#F1F2F8" />
                                        </HorizontalStackLayout>
                                    </Border>
                                    <!-- Format chip -->
                                    <Border BackgroundColor="#4F46E5"
                                            StrokeShape="RoundRectangle 999"
                                            Padding="8,3"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Start"
                                            Margin="8,8,0,0">
                                        <Label Text="{Binding Format}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="10" TextColor="#FFFFFF" />
                                    </Border>
                                </Grid>
                                <!-- Card body -->
                                <VerticalStackLayout Padding="12" Spacing="4">
                                    <!-- Movie TITLE -->
                                    <Label Text="{Binding Title}"
                                           FontFamily="OpenSansSemibold"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1"
                                           TextColor="#1A1A2E" />
                                    <!-- Tagline -->
                                    <Label Text="{Binding Tagline}"
                                           FontSize="10"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2"
                                           TextColor="#49454F" />
                                    <!-- Genre + duration + certificate -->
                                    <HorizontalStackLayout Spacing="4" Margin="0,4,0,0">
                                        <Label Text="{Binding PrimaryGenre}"
                                               FontSize="9" TextColor="#7A7B8C"
                                               VerticalTextAlignment="Center" />
                                        <Label Text="·" FontSize="9" TextColor="#7A7B8C" />
                                        <Label Text="{Binding Duration}"
                                               FontSize="9" TextColor="#7A7B8C"
                                               VerticalTextAlignment="Center" />
                                        <Label Text="·" FontSize="9" TextColor="#7A7B8C" />
                                        <Label Text="{Binding Certificate}"
                                               FontSize="9" TextColor="#7A7B8C"
                                               VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40" Spacing="8" HorizontalOptions="Center">
                        <Label Text="🎞️" FontSize="48" HorizontalTextAlignment="Center" />
                        <Label Text="No movies match your filters"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               TextColor="#1A1A2E" />
                        <Label Text="Try clearing the search or selecting a different genre."
                               FontSize="11"
                               HorizontalTextAlignment="Center"
                               TextColor="#49454F" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
