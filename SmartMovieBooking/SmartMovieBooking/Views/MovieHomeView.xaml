<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:syncfusionButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:syncfusionCards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
             xmlns:syncfusionCarousel="clr-namespace:Syncfusion.Maui.Carousel;assembly=Syncfusion.Maui.Carousel"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:chips="clr-namespace:Syncfusion.Maui.Toolkit.Chips;assembly=Syncfusion.Maui.Toolkit"
             xmlns:vm="clr-namespace:SmartMovieBooking.ViewModels"
             xmlns:models="clr-namespace:SmartMovieBooking.Models"
             xmlns:controls="clr-namespace:SmartMovieBooking.Views"
             xmlns:behaviors="clr-namespace:SmartMovieBooking.Behaviors"
             x:Class="SmartMovieBooking.Views.MovieHomeView"
             x:DataType="vm:HomeViewModel"
             Title="Movie Home">

    <Grid RowDefinitions="{OnIdiom Default='*,Auto', Phone='*,72'}"
          ColumnDefinitions="{OnIdiom Default='200,*', Phone='*'}"
          BackgroundColor="#F6F7FC">

        <controls:AppSideBar Grid.Row="{OnIdiom Default=0, Phone=1}"
                             ActiveTab="Movies" />

        <Grid Grid.Row="{OnIdiom Default=0, Phone=0}"
              Grid.Column="{OnIdiom Default='1', Phone='0'}"
              MaximumWidthRequest="1200"
              RowDefinitions="*"
              Padding="{OnIdiom Default='24', Phone='12,12,12,0'}">

            <ScrollView Grid.Row="0"
                        VerticalOptions="Fill"
                        HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="24">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="16"
                          RowSpacing="14">
                        <VerticalStackLayout Grid.Row="0" Grid.ColumnSpan="2" Spacing="4">
                            <Label Text="Discover Movies"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="30"
                                   FontAttributes="Bold"
                                   TextColor="#17182B" />
                            <Label Text="Browse featured titles, what’s now showing, and what’s coming next."
                                   FontSize="13"
                                   TextColor="#5C5F76" />
                        </VerticalStackLayout>

                        <inputLayout:SfTextInputLayout Grid.Row="1"
                                                       Grid.ColumnSpan="2"
                                                       Hint="Search movies, cinemas, genres…"
                                                       OutlineCornerRadius="20"
                                                       InputViewPadding="20,8"
                                                       ReserveSpaceForAssistiveLabels="False"
                                                       FocusedStrokeThickness="0.8"
                                                       UnfocusedStrokeThickness="0.8"
                                                       Stroke="#D8DBE9"
                                                       Background="#FFFFFF"
                                                       HeightRequest="56"
                                                       ContainerType="Outlined">
                            <inputLayout:SfTextInputLayout.HintLabelStyle>
                                <inputLayout:LabelStyle FontSize="14"
                                                        FontFamily="OpenSansSemibold" />
                            </inputLayout:SfTextInputLayout.HintLabelStyle>
                            <Entry x:Name="SearchEntry"
                                   TextChanged="OnSearchChanged"
                                   BackgroundColor="Transparent"
                                   PlaceholderColor="#7A7B8C"
                                   TextColor="#1A1A2E"
                                   HeightRequest="40"
                                   Margin="12,0,0,4" />
                        </inputLayout:SfTextInputLayout>

                        <chips:SfChipGroup Grid.Row="2"
                                           Grid.Column="0"
                                           x:Name="categoryChipGroup"
                                           ChipClicked="CategoryChipGroup_ChipClicked"
                                           ItemsSource="{Binding Genres}"
                                           ChipType="Choice"
                                           ChoiceMode="Single"
                                           ChipCornerRadius="18"
                                           VerticalOptions="Center"
                                           ChipPadding="{OnIdiom Default='10,8', Phone='8,6'}"
                                           SelectedChipBackground="#4A3DE0"
                                           ChipTextColor="{AppThemeBinding Light=#4B4F63, Dark=#FFFFFF}"
                                           SelectedChipTextColor="#FFFFFF"
                                           ChipStrokeThickness="1"
                                           ChipTextSize="13"
                                           SelectedItem="{Binding SelectedGenre, Mode=TwoWay}">
                            <chips:SfChipGroup.ChipLayout>
                                <FlexLayout JustifyContent="Start"
                                            Wrap="Wrap"
                                            Direction="Row" />
                            </chips:SfChipGroup.ChipLayout>
                        </chips:SfChipGroup>

                        <Border Grid.Row="2"
                                Grid.Column="1"
                                Background="#FFFFFF"
                                Stroke="#ECECF4"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="12,10"
                                VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Border Background="#EEF0FF"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="8">
                                    <Label Text="📍"
                                           FontSize="18"
                                           VerticalTextAlignment="Center"
                                           HorizontalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="0">
                                    <Label Text="New York, NY"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13"
                                           TextColor="#17182B" />
                                    <Label Text="10 movies in catalog"
                                           FontSize="11"
                                           TextColor="#5C5F76" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Now Showing"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="#1A1D33" />
                                <Label Text="Fresh releases and audience favorites"
                                       FontSize="13"
                                       TextColor="#5C5F76" />
                            </VerticalStackLayout>
                        </Grid>

                        <syncfusion:SfListView ItemsSource="{Binding PopularMovies}"
                                               ItemSpacing="16"
                                               BackgroundColor="Transparent"
                                               Orientation="Horizontal"
                                               HeightRequest="280"
                                               ScrollBarVisibility="Never"
                                               AutoFitMode="DynamicHeight"
                                               SelectionMode="None">
                            <syncfusion:SfListView.ItemsLayout>
                                <syncfusion:GridLayout SpanCount="1" />
                            </syncfusion:SfListView.ItemsLayout>
                            <syncfusion:SfListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Movie">
                                    <Border WidthRequest="270"
                                            HeightRequest="278"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 30">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0"
                                                                 EndPoint="1,1">
                                                <GradientStop Color="#1A2044" Offset="0" />
                                                <GradientStop Color="#263061" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid Padding="18"
                                              RowDefinitions="Auto,Auto,*"
                                              RowSpacing="12">
                                            <HorizontalStackLayout Spacing="8">
                                                <Border Background="#4954BE"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 999"
                                                        Padding="12,6">
                                                    <Label Text="NOW SHOWING"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="10"
                                                           TextColor="White" />
                                                </Border>
                                                <Border Background="#33448F"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 999"
                                                        Padding="12,6">
                                                    <Label Text="{Binding Rating, StringFormat='★ {0}'}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="10"
                                                           TextColor="#A8C8FF" />
                                                </Border>
                                            </HorizontalStackLayout>

                                            <VerticalStackLayout Grid.Row="1" Spacing="10">
                                                <Label Text="{Binding Title}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="22"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="2"
                                                       TextColor="White" />
                                                <Label Text="{Binding Tagline}"
                                                       FontSize="14"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="3"
                                                       TextColor="#DEE5FF" />
                                            </VerticalStackLayout>

                                            <HorizontalStackLayout Grid.Row="2"
                                                                   VerticalOptions="End"
                                                                   Spacing="10">
                                                <Border Background="#FFFFFF14"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 999"
                                                        Padding="10,6">
                                                    <Label Text="{Binding PrimaryGenre}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="11"
                                                           TextColor="#E9ECFF" />
                                                </Border>
                                                <Border Background="#FFFFFF14"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 999"
                                                        Padding="10,6">
                                                    <Label Text="{Binding Duration}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="11"
                                                           TextColor="#E9ECFF" />
                                                </Border>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </syncfusion:SfListView.ItemTemplate>
                        </syncfusion:SfListView>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Coming Soon"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="#1A1D33" />
                                <Label Text="Upcoming premieres and next-month releases"
                                       FontSize="13"
                                       TextColor="#5C5F76" />
                            </VerticalStackLayout>
                        </Grid>

                        <syncfusion:SfListView ItemsSource="{Binding ComingSoonMovies}"
                                               SelectionMode="None"
                                               Orientation="Horizontal"
                                               ItemSpacing="14"
                                               ScrollBarVisibility="Never"
                                               HeightRequest="330">
                            <syncfusion:SfListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Movie">
                                    <Border WidthRequest="180"
                                            Stroke="#E7EAF2"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 22"
                                            Background="White"
                                            Padding="10">
                                        <VerticalStackLayout Spacing="10">
                                            <Border HeightRequest="240"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 18">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0"
                                                                         EndPoint="1,1">
                                                        <GradientStop Color="#1A2948" Offset="0" />
                                                        <GradientStop Color="#203A5A" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid Padding="16">
                                                    <VerticalStackLayout VerticalOptions="End"
                                                                         Spacing="8">
                                                        <Border Background="#FFFFFF14"
                                                                StrokeThickness="0"
                                                                StrokeShape="RoundRectangle 999"
                                                                Padding="10,5"
                                                                HorizontalOptions="Start">
                                                            <Label Text="COMING SOON"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="9"
                                                                   TextColor="White" />
                                                        </Border>
                                                        <Label Text="{Binding ReleaseDate, StringFormat='Releases {0}'}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="11"
                                                               TextColor="#DDE6FF" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Border>

                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="{Binding Title}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="2"
                                                       TextColor="#1A1D33" />
                                                <Label Text="{Binding Tagline}"
                                                       FontSize="11"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="2"
                                                       TextColor="#5B5D73" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </syncfusion:SfListView.ItemTemplate>
                        </syncfusion:SfListView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="0"
                  BackgroundColor="#FFFFFFC9"
                  IsVisible="{Binding IsLoading}">
                <ActivityIndicator IsRunning="True"
                                   IsVisible="True"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Color="#4A3DE0" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>