<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartMovieBooking.ViewModels"
             x:Class="SmartMovieBooking.Views.PaymentConfirmationView"
             x:DataType="vm:PaymentConfirmationViewModel">

    <Grid RowDefinitions="*,Auto" BackgroundColor="White">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="20" Padding="24">

                <!-- Success animation -->
                <Grid HeightRequest="120" HorizontalOptions="Center">
                    <Ellipse Fill="{DynamicResource ThemePrimaryContainer}"
                             WidthRequest="120" HeightRequest="120" />
                    <Label Text="✓" FontSize="64" FontFamily="PlusJakartaExtraBold"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           TextColor="{DynamicResource ThemeOnPrimaryContainer}" />
                </Grid>

                <!-- Title -->
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="Booking Confirmed!"
                           FontFamily="PlusJakartaExtraBold" FontSize="22"
                           HorizontalTextAlignment="Center"
                           TextColor="{DynamicResource ThemeOnSurface}" />
                    <Label Text="Your tickets have been booked successfully."
                           Style="{StaticResource BodyMdLabel}"
                           HorizontalTextAlignment="Center"
                           TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                </VerticalStackLayout>

                <!-- Booking ID + Total -->
                <Border Style="{StaticResource SurfaceCard}" Padding="20">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="BOOKING ID" FontFamily="PlusJakartaSemiBold" FontSize="10"
                                   TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                            <Label Text="{Binding BookingId}" FontFamily="PlusJakartaBold" FontSize="14"
                                   TextColor="{DynamicResource ThemePrimary}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="TOTAL PAID" FontFamily="PlusJakartaSemiBold" FontSize="10"
                                   TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                            <Label Text="{Binding FormattedTotal}" FontFamily="PlusJakartaBold" FontSize="14"
                                   TextColor="{DynamicResource ThemeOnSurface}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Ticket details -->
                <Border Style="{StaticResource SurfaceCard}" Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="TICKET DETAILS" FontFamily="PlusJakartaSemiBold" FontSize="10"
                               TextColor="{DynamicResource ThemeOnSurfaceVariant}" />

                        <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    WidthRequest="80" HeightRequest="100"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{DynamicResource ThemeSurfaceContainer}">
                                <Label Text="🎬" FontSize="32"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                       TextColor="{DynamicResource ThemeOutline}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding MovieTitle}"
                                       FontFamily="PlusJakartaBold" FontSize="14"
                                       LineBreakMode="TailTruncation" MaxLines="1"
                                       TextColor="{DynamicResource ThemeOnSurface}" />
                                <Label Text="{Binding TheaterName}" Style="{StaticResource BodySmLabel}"
                                       LineBreakMode="TailTruncation" MaxLines="1"
                                       TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                                <Label Text="{Binding ShowtimeLabel}" Style="{StaticResource BodySmLabel}"
                                       TextColor="{DynamicResource ThemePrimary}" />
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="🎫" FontSize="11" />
                                    <Label Text="{Binding SeatsDisplay}"
                                           FontFamily="InterSemiBold" FontSize="11"
                                           TextColor="{DynamicResource ThemeOnSurface}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- QR placeholder -->
                        <Grid HeightRequest="160" Margin="0,12,0,0">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{DynamicResource ThemeSurfaceContainerLow}">
                                <Label Text="QR CODE PLACEHOLDER" FontFamily="PlusJakartaBold" FontSize="11"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                       TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Action buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Grid.Column="0" Text="📥 Download"
                            Style="{StaticResource OutlinedButton}" />
                    <Button Grid.Column="1" Text="↗ Share"
                            Style="{StaticResource OutlinedButton}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Sticky bottom CTA -->
        <Grid Grid.Row="1" BackgroundColor="{DynamicResource ThemeSurface}"
              Padding="20,12,20,16"
              ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Button Grid.Column="0" Text="Back to Home"
                    Clicked="OnDoneClicked"
                    Style="{StaticResource GhostButton}" />
            <Button Grid.Column="1" Text="View My Bookings →"
                    Clicked="OnViewBookingsClicked"
                    Style="{StaticResource PrimaryButton}" />
        </Grid>
    </Grid>
</ContentPage>