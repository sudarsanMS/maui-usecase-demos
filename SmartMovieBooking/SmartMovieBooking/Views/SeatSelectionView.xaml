<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusionCards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
             xmlns:syncfusionButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:vm="clr-namespace:SmartMovieBooking.ViewModels"
             x:Class="SmartMovieBooking.Views.SeatSelectionView"
             x:DataType="vm:SeatSelectionViewModel"
             Title="Select Tickets">
    <Grid MaximumWidthRequest="1200"
          Padding="20"
          RowSpacing="16"
          RowDefinitions="Auto,*,Auto"
          BackgroundColor="#FFFFFF">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label x:Name="ScreenTitleLabel"
                   Text="Select Tickets"
                   FontFamily="OpenSansSemibold"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#1A1A2E" />
            <Label x:Name="TheaterLabel"
                   Text=""
                   FontSize="13"
                   TextColor="#49454F" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16">
                <syncfusionCards:SfCardView CornerRadius="16"
                                            BackgroundColor="#1A1A2E"
                                            Padding="20">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🎬 All eyes this way 🎬"
                               FontFamily="OpenSansSemibold"
                               FontSize="11"
                               HorizontalTextAlignment="Center"
                               TextColor="#FFFFFF" />
                        <Label Text="Screening time"
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               TextColor="#C7C8D8" />
                        <Label Text="{Binding ShowtimeLabel}"
                               FontFamily="OpenSansSemibold"
                               FontSize="16"
                               HorizontalTextAlignment="Center"
                               TextColor="#FFFFFF" />
                    </VerticalStackLayout>
                </syncfusionCards:SfCardView>

                <syncfusionCards:SfCardView CornerRadius="16"
                                            BackgroundColor="#FFFFFF"
                                            Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Ticket Count"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="13"
                                   TextColor="#7A7B8C" />
                            <Label Text="Choose how many tickets you need"
                                   FontFamily="OpenSansSemibold"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="#1A1A2E" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                            <syncfusionButtons:SfButton Text="-"
                                                         WidthRequest="44"
                                                         HeightRequest="44"
                                                         CornerRadius="12"
                                                         BackgroundColor="#F1F2F8"
                                                         TextColor="#1A1A2E"
                                                         FontFamily="OpenSansSemibold"
                                                         FontAttributes="Bold"
                                                         FontSize="22"
                                                         Clicked="OnDecreaseClicked" />

                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding SelectedCount}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="28"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="#3525CD" />
                                <Label Text="tickets"
                                       FontSize="11"
                                       HorizontalTextAlignment="Center"
                                       TextColor="#7A7B8C" />
                            </VerticalStackLayout>

                            <syncfusionButtons:SfButton Grid.Column="2"
                                                         Text="+"
                                                         WidthRequest="44"
                                                         HeightRequest="44"
                                                         CornerRadius="12"
                                                         BackgroundColor="#3525CD"
                                                         TextColor="#FFFFFF"
                                                         FontFamily="OpenSansSemibold"
                                                         FontAttributes="Bold"
                                                         FontSize="22"
                                                         Clicked="OnIncreaseClicked" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="Price per ticket"
                                   FontSize="12"
                                   TextColor="#7A7B8C" />
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding ShowtimeStartTime}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="12"
                                   TextColor="#1A1A2E" />

                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="Subtotal"
                                   FontSize="12"
                                   TextColor="#7A7B8C" />
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding FormattedSubtotal}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="12"
                                   TextColor="#1A1A2E" />

                            <Label Grid.Row="2" Grid.Column="0"
                                   Text="Convenience fee"
                                   FontSize="12"
                                   TextColor="#7A7B8C" />
                            <Label Grid.Row="2" Grid.Column="1"
                                   Text="{Binding FormattedConvenienceFee}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="12"
                                   TextColor="#1A1A2E" />
                        </Grid>
                    </VerticalStackLayout>
                </syncfusionCards:SfCardView>
            </VerticalStackLayout>
        </ScrollView>

        <syncfusionCards:SfCardView Grid.Row="2"
                                     CornerRadius="0"
                                     BackgroundColor="#FFFFFF"
                                     Padding="20,12,20,16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label x:Name="SeatsSummaryLabel"
                           Text="0 tickets"
                           FontFamily="OpenSansSemibold"
                           FontSize="13"
                           TextColor="#1A1A2E" />
                    <Label x:Name="TotalLabel"
                           Text="$0.00"
                           FontFamily="OpenSansSemibold"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="#3525CD" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <syncfusionButtons:SfButton Text="Cancel"
                                                 BackgroundColor="#3525CD"
                                                 TextColor="#FFFFFF"
                                                 CornerRadius="10"
                                                 FontFamily="OpenSansSemibold"
                                                 WidthRequest="88"
                                                 HeightRequest="40"
                                                 Clicked="OnCancelClicked" />
                    <syncfusionButtons:SfButton Text="Proceed to Pay"
                                                 BackgroundColor="#3525CD"
                                                 TextColor="#FFFFFF"
                                                 CornerRadius="10"
                                                 FontFamily="OpenSansSemibold"
                                                 FontAttributes="Bold"
                                                 WidthRequest="160"
                                                 HeightRequest="40"
                                                 Clicked="OnConfirmClicked" />
                </HorizontalStackLayout>
            </Grid>
        </syncfusionCards:SfCardView>
    </Grid>
</ContentPage>