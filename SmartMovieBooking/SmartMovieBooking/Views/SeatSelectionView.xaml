<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusionCards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Core"
             xmlns:syncfusionButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:vm="clr-namespace:SmartMovieBooking.ViewModels"
             x:Class="SmartMovieBooking.Views.SeatSelectionView"
             x:DataType="vm:SeatSelectionViewModel"
             Title="Select Tickets">
    <Grid MaximumWidthRequest="1200"
          Padding="20"
          RowSpacing="16"
          RowDefinitions="Auto,*,Auto"
          BackgroundColor="#FFFFFF">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label x:Name="ScreenTitleLabel"
                   Text="Select Tickets"
                   FontFamily="OpenSansSemibold"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#1A1A2E" />
            <Label x:Name="TheaterLabel"
                   Text=""
                   FontSize="13"
                   TextColor="#49454F" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16">
                <syncfusionCards:SfCardView CornerRadius="16"
                                            BackgroundColor="#1A1A2E"
                                            Padding="20">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="🎬"
                               FontSize="28"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Choose the number of tickets"
                               FontFamily="OpenSansSemibold"
                               FontSize="16"
                               HorizontalTextAlignment="Center"
                               TextColor="#FFFFFF" />
                        <Label Text="Adjust quantity for the selected showtime"
                               FontSize="11"
                               HorizontalTextAlignment="Center"
                               TextColor="#D1D5DB" />
                    </VerticalStackLayout>
                </syncfusionCards:SfCardView>

                <syncfusionCards:SfCardView CornerRadius="16"
                                            BackgroundColor="#FFFFFF"
                                            Padding="20">
                    <VerticalStackLayout Spacing="18">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                            <syncfusionButtons:SfButton Text="−"
                                                         WidthRequest="48"
                                                         HeightRequest="48"
                                                         CornerRadius="14"
                                                         BackgroundColor="#F1F2F8"
                                                         TextColor="#1A1A2E"
                                                         FontFamily="OpenSansSemibold"
                                                         FontAttributes="Bold"
                                                         FontSize="24"
                                                         Clicked="OnDecreaseClicked" />

                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding SelectedCount}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="34"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="#3525CD" />
                                <Label Text="tickets"
                                       FontSize="11"
                                       HorizontalTextAlignment="Center"
                                       TextColor="#7A7B8C" />
                            </VerticalStackLayout>

                            <syncfusionButtons:SfButton Grid.Column="2"
                                                         Text="+"
                                                         WidthRequest="48"
                                                         HeightRequest="48"
                                                         CornerRadius="14"
                                                         BackgroundColor="#3525CD"
                                                         TextColor="#FFFFFF"
                                                         FontFamily="OpenSansSemibold"
                                                         FontAttributes="Bold"
                                                         FontSize="24"
                                                         Clicked="OnIncreaseClicked" />
                        </Grid>

                        <Border BackgroundColor="#F8F7FF"
                                StrokeShape="RoundRectangle 14"
                                Padding="14">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Showtime"
                                           FontSize="12"
                                           TextColor="#7A7B8C" />
                                    <Label Text="{Binding ShowtimeStartTime}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="12"
                                           TextColor="#1A1A2E" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Price per ticket"
                                           FontSize="12"
                                           TextColor="#7A7B8C" />
                                    <Label Text="{Binding FormattedSubtotal}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="12"
                                           TextColor="#1A1A2E" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Convenience fee"
                                           FontSize="12"
                                           TextColor="#7A7B8C" />
                                    <Label Text="{Binding FormattedConvenienceFee}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="12"
                                           TextColor="#1A1A2E" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </syncfusionCards:SfCardView>
            </VerticalStackLayout>
        </ScrollView>

        <syncfusionCards:SfCardView Grid.Row="2"
                                    CornerRadius="0"
                                    BackgroundColor="#FFFFFF"
                                    Padding="20,12,20,16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label x:Name="SeatsSummaryLabel"
                           Text="0 tickets"
                           FontFamily="OpenSansSemibold"
                           FontSize="13"
                           TextColor="#1A1A2E" />
                    <Label x:Name="TotalLabel"
                           Text="$0.00"
                           FontFamily="OpenSansSemibold"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="#3525CD" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <syncfusionButtons:SfButton Text="Cancel"
                                                 BackgroundColor="Transparent"
                                                 TextColor="#49454F"
                                                 CornerRadius="10"
                                                 FontFamily="OpenSansSemibold"
                                                 WidthRequest="88"
                                                 HeightRequest="40"
                                                 Clicked="OnCancelClicked" />
                    <syncfusionButtons:SfButton Text="Proceed to Pay"
                                                 BackgroundColor="#3525CD"
                                                 TextColor="#FFFFFF"
                                                 CornerRadius="10"
                                                 FontFamily="OpenSansSemibold"
                                                 FontAttributes="Bold"
                                                 WidthRequest="160"
                                                 HeightRequest="40"
                                                 Clicked="OnConfirmClicked" />
                </HorizontalStackLayout>
            </Grid>
        </syncfusionCards:SfCardView>
    </Grid>
</ContentPage>
