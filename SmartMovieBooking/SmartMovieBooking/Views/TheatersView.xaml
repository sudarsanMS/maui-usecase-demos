<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartMovieBooking.Views.TheatersView">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="🏛 Theaters"
                   FontFamily="PlusJakartaBold" FontSize="24"
                   TextColor="{DynamicResource ThemeOnBackground}" />
            <Label Text="Phase 2 will replace this placeholder with the date strip, filters panel, and theater cards."
                   FontFamily="InterRegular" FontSize="14"
                   TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>