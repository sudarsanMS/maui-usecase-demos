<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartMovieBooking.ViewModels"
             xmlns:models="clr-namespace:SmartMovieBooking.Models"
             xmlns:controls="clr-namespace:SmartMovieBooking.Controls"
             x:Class="SmartMovieBooking.Views.TheatersView"
             x:DataType="vm:TheatersViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- Top app bar: back, title, share, avatar -->
        <Grid Grid.Row="0" Padding="20,12,20,8" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
            <Button Grid.Column="0" Text="←" Clicked="OnBackClicked"
                    Style="{StaticResource IconButton}" WidthRequest="40" HeightRequest="40" />
            <Label Grid.Column="1" Text="Theaters"
                   FontFamily="PlusJakartaBold" FontSize="20"
                   VerticalTextAlignment="Center" HorizontalTextAlignment="Center"
                   TextColor="{DynamicResource ThemeOnBackground}" />
            <Button Grid.Column="2" Text="↗" Clicked="OnShareClicked"
                    Style="{StaticResource IconButton}" WidthRequest="40" HeightRequest="40" />
            <Border Grid.Column="3" WidthRequest="40" HeightRequest="40"
                    StrokeThickness="0" StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource ThemePrimary}">
                <Label Text="AC" FontFamily="PlusJakartaBold" FontSize="12"
                       TextColor="{DynamicResource ThemeOnPrimary}"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="0,8,0,80" Spacing="20">

                <!-- Selected movie context card -->
                <Grid Padding="20,0">
                    <Border Style="{StaticResource SurfaceCardTight}" Padding="12">
                        <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    WidthRequest="80" HeightRequest="100"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{DynamicResource ThemeSurfaceContainer}">
                                <Label Text="🎬" FontSize="32"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                       TextColor="{DynamicResource ThemeOutline}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6">
                                    <Border BackgroundColor="{DynamicResource ThemeSurfaceContainerLow}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 4"
                                            Padding="6,2">
                                        <Label Text="{Binding Movie.Certificate, FallbackValue='PG-13'}"
                                               FontFamily="InterSemiBold" FontSize="10"
                                               TextColor="{DynamicResource ThemePrimary}" />
                                    </Border>
                                    <Border BackgroundColor="{DynamicResource ThemeSurfaceContainerLow}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 4"
                                            Padding="6,2">
                                        <Label Text="{Binding Movie.PrimaryGenre, FallbackValue='Sci-Fi'}"
                                               FontFamily="InterSemiBold" FontSize="10"
                                               TextColor="{DynamicResource ThemePrimary}" />
                                    </Border>
                                    <Label Text="{Binding Movie.Duration, FallbackValue='2h 45m'}"
                                           FontFamily="InterSemiBold" FontSize="10"
                                           VerticalTextAlignment="Center"
                                           TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Movie.Title, FallbackValue='Select a movie'}"
                                       FontFamily="PlusJakartaBold" FontSize="16"
                                       LineBreakMode="TailTruncation" MaxLines="1"
                                       TextColor="{DynamicResource ThemeOnSurface}" />
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="★" FontSize="12" TextColor="#FFC107" />
                                    <Label Text="{Binding Movie.Rating, FallbackValue='4.9'}"
                                           FontFamily="PlusJakartaBold" FontSize="12"
                                           TextColor="{DynamicResource ThemeOnSurface}" />
                                    <Label Text="{Binding Movie.Tagline, FallbackValue='NYC Theaters showing today'}"
                                           Style="{StaticResource BodySmLabel}"
                                           LineBreakMode="TailTruncation" MaxLines="1"
                                           TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="Change"
                                    Style="{StaticResource OutlinedButton}"
                                    FontSize="11" Padding="10,4"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Select Date label -->
                <Grid Padding="20,0" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Select Date"
                           FontFamily="PlusJakartaBold" FontSize="14"
                           VerticalTextAlignment="Center"
                           TextColor="{DynamicResource ThemeOnBackground}" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="📅" FontSize="12" />
                        <Label Text="October 2024"
                               FontFamily="PlusJakartaBold" FontSize="12"
                               TextColor="{DynamicResource ThemePrimary}" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Date strip -->
                <CollectionView ItemsSource="{Binding DateChips}"
                                HeightRequest="76"
                                SelectionMode="Single"
                                SelectionChanged="OnDateChipSelected">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DateChipItem">
                            <Grid Padding="20,0,0,0" WidthRequest="64">
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                        Padding="0,8">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource ThemePrimary}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSurfaceContainerLowest}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="{Binding Label}"
                                               FontFamily="PlusJakartaSemiBold" FontSize="10"
                                               HorizontalTextAlignment="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="TextColor" Value="{DynamicResource ThemeOutline}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding DayNumber}"
                                               FontFamily="PlusJakartaExtraBold" FontSize="20"
                                               HorizontalTextAlignment="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="TextColor" Value="{DynamicResource ThemeOnSurface}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding Weekday}"
                                               FontFamily="InterSemiBold" FontSize="9"
                                               HorizontalTextAlignment="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                    <Setter Property="Opacity" Value="0.8" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="TextColor" Value="{DynamicResource ThemeOnSurfaceVariant}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Format + Price chips -->
                <Grid Padding="20,0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <Border Grid.Column="0" BackgroundColor="{DynamicResource ThemeSurfaceContainerLow}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 999" Padding="12,6">
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="🎞️" FontSize="11" />
                            <Label Text="{Binding SelectedFormat}"
                                   FontFamily="PlusJakartaSemiBold" FontSize="12"
                                   TextColor="{DynamicResource ThemeOnSurface}" />
                            <Label Text="▾" FontSize="10"
                                   TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                        </HorizontalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{DynamicResource ThemeSurfaceContainerLow}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 999" Padding="12,6">
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="🌐" FontSize="11" />
                            <Label Text="English"
                                   FontFamily="PlusJakartaSemiBold" FontSize="12"
                                   TextColor="{DynamicResource ThemeOnSurface}" />
                            <Label Text="▾" FontSize="10"
                                   TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                        </HorizontalStackLayout>
                    </Border>
                    <Border Grid.Column="2" BackgroundColor="{DynamicResource ThemeSurfaceContainerLow}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 999" Padding="12,6">
                        <Label Text="$15 – $30"
                               FontFamily="PlusJakartaSemiBold" FontSize="12"
                               TextColor="{DynamicResource ThemeOnSurface}" />
                    </Border>
                    <Button Grid.Column="3" Text="Reset"
                            Style="{StaticResource OutlinedButton}"
                            FontSize="11" Padding="10,4" />
                </Grid>

                <!-- Theater cards stacked -->
                <CollectionView ItemsSource="{Binding Theaters}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Theater">
                            <Grid Padding="20,0,20,16">
                                <VerticalStackLayout Spacing="12">
                                    <!-- Theater header -->
                                    <Border Style="{StaticResource SurfaceCard}" Padding="16">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border Grid.Column="0"
                                                    WidthRequest="44" HeightRequest="44"
                                                    StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{DynamicResource ThemeSurfaceContainerLow}">
                                                <Label Text="{Binding Icon, FallbackValue='🎬'}" FontSize="22"
                                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                                       TextColor="{DynamicResource ThemePrimary}" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Name}"
                                                       FontFamily="PlusJakartaBold" FontSize="14"
                                                       LineBreakMode="TailTruncation" MaxLines="1"
                                                       TextColor="{DynamicResource ThemeOnSurface}" />
                                                <Label Text="{Binding Location}"
                                                       Style="{StaticResource BodySmLabel}"
                                                       LineBreakMode="TailTruncation" MaxLines="1"
                                                       TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="2" Text="♡"
                                                    Style="{StaticResource IconButton}"
                                                    WidthRequest="36" HeightRequest="36" />
                                        </Grid>
                                    </Border>

                                    <!-- Facility pills -->
                                    <HorizontalStackLayout Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:TheaterFacility">
                                                <Border BackgroundColor="{DynamicResource ThemeSurfaceContainerLow}"
                                                        StrokeThickness="0" StrokeShape="RoundRectangle 6"
                                                        Padding="8,4">
                                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                        <Label Text="{Binding Icon}" FontSize="10"
                                                               TextColor="{DynamicResource ThemePrimary}" />
                                                        <Label Text="{Binding Label}" FontFamily="InterSemiBold" FontSize="10"
                                                               TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                                                    </HorizontalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>

                                    <!-- Showtime pills grid -->
                                    <FlexLayout BindableLayout.ItemsSource="{Binding Showtimes}"
                                                Wrap="Wrap"
                                                Direction="Row"
                                                JustifyContent="Start"
                                                AlignItems="Start">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:Showtime">
                                                <controls:ShowtimePillView Margin="0,0,8,8"
                                                                           Showtime="{Binding .}" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>

                                    <!-- Capacity + Price + Continue -->
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                            <Ellipse WidthRequest="8" HeightRequest="8"
                                                     Fill="{DynamicResource ThemeSuccess}"
                                                     VerticalOptions="Center" />
                                            <Label Text="{Binding AvailableSeats, StringFormat='{}{0} seats left'}"
                                                   Style="{StaticResource BodySmLabel}"
                                                   TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding PriceFrom, StringFormat='{}{0} from'}"
                                               FontFamily="PlusJakartaBold" FontSize="13"
                                               VerticalTextAlignment="Center"
                                               TextColor="{DynamicResource ThemePrimary}" />
                                    </Grid>

                                    <Button Text="Select Showtime →"
                                            Style="{StaticResource PrimaryButton}" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Footer info bar -->
                <Grid Padding="20,0">
                    <Border BackgroundColor="{DynamicResource ThemeSurfaceContainerLow}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="✓" FontSize="14" TextColor="{DynamicResource ThemePrimary}" />
                            <Label Text="100% Guaranteed Reserved Seating • Free cancellation up to 2h prior"
                                   Style="{StaticResource BodySmLabel}"
                                   LineBreakMode="WordWrap"
                                   TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- AI Copilot FAB -->
        <Grid Grid.Row="1" Margin="0,0,20,20"
              HorizontalOptions="End" VerticalOptions="End">
            <controls:AiCopilotFab Clicked="OnAiFabClicked" />
        </Grid>
    </Grid>
</ContentView>