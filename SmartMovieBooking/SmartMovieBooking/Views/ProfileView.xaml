<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartMovieBooking.ViewModels"
             x:Class="SmartMovieBooking.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Top app bar -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Profile" Style="{StaticResource HeadlineLgLabel}"
                       TextColor="{DynamicResource ThemeOnBackground}" />
                <Border Grid.Column="1" WidthRequest="40" HeightRequest="40"
                        StrokeThickness="0" StrokeShape="RoundRectangle 20"
                        BackgroundColor="{DynamicResource ThemePrimaryContainer}">
                    <Label Text="👤" FontSize="18"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
            </Grid>

            <!-- Profile card -->
            <Border Style="{StaticResource SurfaceCard}">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Border WidthRequest="80" HeightRequest="80"
                            StrokeThickness="0" StrokeShape="RoundRectangle 40"
                            BackgroundColor="{DynamicResource ThemePrimaryContainer}">
                        <Label Text="{Binding Initials}" FontSize="28"
                               FontFamily="PlusJakartaBold"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                               TextColor="{DynamicResource ThemeOnPrimaryContainer}" />
                    </Border>
                    <Label Text="{Binding Name}" Style="{StaticResource HeadlineMdLabel}"
                           HorizontalTextAlignment="Center"
                           TextColor="{DynamicResource ThemeOnSurface}" />
                    <Label Text="{Binding Email}" Style="{StaticResource BodyMdLabel}"
                           HorizontalTextAlignment="Center"
                           TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                </VerticalStackLayout>
            </Border>

            <!-- Stats -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Style="{StaticResource SurfaceCardTight}" Padding="12">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="18" FontSize="22" FontFamily="PlusJakartaExtraBold"
                               HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource ThemePrimary}" />
                        <Label Text="Watched" Style="{StaticResource LabelSmLabel}"
                               HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource SurfaceCardTight}" Padding="12">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="24" FontSize="22" FontFamily="PlusJakartaExtraBold"
                               HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource ThemePrimary}" />
                        <Label Text="Bookings" Style="{StaticResource LabelSmLabel}"
                               HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SurfaceCardTight}" Padding="12">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="65%" FontSize="22" FontFamily="PlusJakartaExtraBold"
                               HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource ThemePrimary}" />
                        <Label Text="IMAX" Style="{StaticResource LabelSmLabel}"
                               HorizontalTextAlignment="Center"
                               TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Menu -->
            <Border Style="{StaticResource SurfaceCard}">
                <VerticalStackLayout Spacing="0">
                    <Grid Padding="0,8" ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Text="🎬" FontSize="18" />
                        <Label Grid.Column="1" Text="My Cinepass"
                               Style="{StaticResource BodyMdLabel}"
                               Margin="12,0,0,0"
                               VerticalTextAlignment="Center"
                               TextColor="{DynamicResource ThemeOnSurface}" />
                        <Label Grid.Column="2" Text="›" FontSize="18"
                               TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource ThemeOutlineVariant}" />
                    <Grid Padding="0,8" ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Text="🎟️" FontSize="18" />
                        <Label Grid.Column="1" Text="Payment Methods"
                               Style="{StaticResource BodyMdLabel}"
                               Margin="12,0,0,0"
                               VerticalTextAlignment="Center"
                               TextColor="{DynamicResource ThemeOnSurface}" />
                        <Label Grid.Column="2" Text="›" FontSize="18"
                               TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{DynamicResource ThemeOutlineVariant}" />
                    <Grid Padding="0,8" ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Text="🔔" FontSize="18" />
                        <Label Grid.Column="1" Text="Notifications"
                               Style="{StaticResource BodyMdLabel}"
                               Margin="12,0,0,0"
                               VerticalTextAlignment="Center"
                               TextColor="{DynamicResource ThemeOnSurface}" />
                        <Label Grid.Column="2" Text="›" FontSize="18"
                               TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Member since -->
            <Label HorizontalTextAlignment="Center" Style="{StaticResource BodySmLabel}"
                   TextColor="{DynamicResource ThemeOnSurfaceVariant}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Member since " />
                        <Span Text="{Binding MemberSince}" FontFamily="InterSemiBold" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>