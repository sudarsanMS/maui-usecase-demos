<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartMovieBooking.Views.BookingsView"
             Title="Bookings">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <VerticalStackLayout Spacing="4">
                <Label Text="Your Bookings" FontFamily="OpenSansSemibold" FontSize="28"
                       FontAttributes="Bold" TextColor="#1A1A2E" />
                <Label Text="Past shows and upcoming reservations"
                       FontSize="13" TextColor="#49454F" />
            </VerticalStackLayout>

            <Label x:Name="EmptyState"
                   Text="No bookings yet. Book your first show from Movie Home!"
                   FontSize="13"
                   TextColor="#49454F"
                   HorizontalTextAlignment="Center"
                   Margin="0,32,0,0"
                   IsVisible="False" />

            <VerticalStackLayout x:Name="BookingsList" Spacing="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
