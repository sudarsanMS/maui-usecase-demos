<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:syncfusionTab="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
             xmlns:syncfusionCards="clr-namespace:Syncfusion.Maui.Cards;assembly=Syncfusion.Maui.Cards"
             xmlns:syncfusionChips="clr-namespace:Syncfusion.Maui.Chips;assembly=Syncfusion.Maui.Core"
             xmlns:syncfusionButtons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="SmartMovieBooking.Views.BookingsView"
             Title="Bookings">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <VerticalStackLayout Spacing="4">
                <Label Text="Your Bookings" FontFamily="OpenSansSemibold" FontSize="28"
                       FontAttributes="Bold" TextColor="#1A1A2E" />
                <Label Text="Past shows and upcoming reservations"
                       FontSize="13" TextColor="#49454F" />
            </VerticalStackLayout>

            <!-- SfTabView: Upcoming / History -->
            <syncfusionTab:SfTabView x:Name="BookingsTabView"
                                       TabBarBackgroundColor="Transparent"
                                       TabBarHeight="44"
                                       TabHeaderPadding="0,4"
                                       TabBarPlacement="Top"
                                       IsScrollable="False">
                <syncfusionTab:SfTabItem Header="UPCOMING">
                    <syncfusionTab:SfTabItem.Content>
                        <syncfusion:SfListView x:Name="UpcomingList"
                                               ItemsSource="{Binding Bookings}"
                                               ItemSpacing="12"
                                               BackgroundColor="Transparent">
                            <syncfusion:SfListView.ItemsLayout>
                                <syncfusion:LinearLayout Orientation="Vertical" />
                            </syncfusion:SfListView.ItemsLayout>
                            <syncfusion:SfListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Booking">
                                    <syncfusionCards:SfCardView CornerRadius="16"
                                                                 BackgroundColor="#FFFFFF"
                                                                 BorderWidth="0"
                                                                 Padding="16">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                            <Border Grid.Column="0"
                                                    WidthRequest="64" HeightRequest="80"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="#F1F2F8">
                                                <Label Text="🎬" FontSize="28"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding Movie.Title, FallbackValue='Movie'}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontAttributes="Bold"
                                                       FontSize="14"
                                                       TextColor="#1A1A2E" />
                                                <Label Text="{Binding Theater.Name, FallbackValue='Theater'}"
                                                       FontSize="11" TextColor="#49454F" />
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="💺" FontSize="11"
                                                           VerticalTextAlignment="Center" />
                                                    <Label Text="{Binding SeatCount, StringFormat='{0} seats'}"
                                                           FontSize="11" TextColor="#49454F"
                                                           VerticalTextAlignment="Center" />
                                                    <Label Text="·" FontSize="11" TextColor="#49454F" />
                                                    <Label Text="{Binding Total, StringFormat='${0:F2}'}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="11" TextColor="#3525CD"
                                                           VerticalTextAlignment="Center" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" Spacing="6"
                                                                 HorizontalOptions="End">
                                                <syncfusionChips:SfChip Text="{Binding Status, FallbackValue='CONFIRMED'}"
                                                                         Background="#9DEAF6"
                                                                         TextColor="#002A33"
                                                                         FontSize="9"
                                                                         FontFamily="OpenSansSemibold"
                                                                          />
                                                <Label Text="{Binding BookingId}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="10"
                                                       TextColor="#7A7B8C" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </syncfusionCards:SfCardView>
                                </DataTemplate>
                            </syncfusion:SfListView.ItemTemplate>
                            <syncfusion:SfListView.EmptyView>
                                <VerticalStackLayout Padding="40" Spacing="8" HorizontalOptions="Center">
                                    <Label Text="🎟️" FontSize="48" HorizontalTextAlignment="Center" />
                                    <Label Text="No upcoming bookings"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="14"
                                           HorizontalTextAlignment="Center"
                                           TextColor="#1A1A2E" />
                                    <Label Text="Book your first show from Movies!"
                                           FontSize="11"
                                           HorizontalTextAlignment="Center"
                                           TextColor="#49454F" />
                                </VerticalStackLayout>
                            </syncfusion:SfListView.EmptyView>
                        </syncfusion:SfListView>
                    </syncfusionTab:SfTabItem.Content>
                </syncfusionTab:SfTabItem>
                <syncfusionTab:SfTabItem Header="HISTORY">
                    <syncfusionTab:SfTabItem.Content>
                        <VerticalStackLayout Padding="20" Spacing="8" HorizontalOptions="Center">
                            <Label Text="🎬" FontSize="48" HorizontalTextAlignment="Center" />
                            <Label Text="No past bookings yet"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   HorizontalTextAlignment="Center"
                                   TextColor="#1A1A2E" />
                        </VerticalStackLayout>
                    </syncfusionTab:SfTabItem.Content>
                </syncfusionTab:SfTabItem>
            </syncfusionTab:SfTabView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
