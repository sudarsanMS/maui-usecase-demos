<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartMovieBooking.Views.BookingsView">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="🎫 Bookings"
                   FontFamily="PlusJakartaBold" FontSize="24"
                   TextColor="{DynamicResource ThemeOnBackground}" />
            <Label Text="Phase 2 will replace this placeholder with the list of bookings."
                   FontFamily="InterRegular" FontSize="14"
                   TextColor="{DynamicResource ThemeOnSurfaceVariant}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>